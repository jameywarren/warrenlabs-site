---
// /graphs, the compare tool.
//
// Runs entirely on the 40 curated public curves in src/data/curves.js, which Jamey approved for
// publication. The payload is assembled at build time and inlined below, so this page needs no
// server and no gate. The full 319-curve archive is NOT here: it stays out of the published site
// and is used for development only.
//
// Three rules from attune/docs/data-provenance.md are load-bearing and carry over:
//   1. RENDER-ONLY, no export or download control anywhere.
//   2. RAW ONLY, never render the diffuse-field-compensated columns.
//   3. NAME THE RIG, NOTHING ELSE. No company name, no location, no rights claims.
//
// Provenance: every curve here came off one fixture, so the page states that once, on the plot.
// When EARS Pro measurements land, curves carry their own bench and a mixed selection must split
// into two stacked panels rather than share an axis. See docs: two fixtures never share an axis.
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Feedback from '../components/Feedback.astro';
import { CURVES, GRID_HZ } from '../data/curves.js';
import { REFERENCES } from '../data/targets.js';
import { MEASUREMENTS } from '../data/measurements.js';
import { HEADPHONES } from '../data/headphones.js';
import WL_ASSETS from '../data/wl-assets.json';   // content-hashed paths, written by tools/vendor.mjs

const byHandle = Object.fromEntries(HEADPHONES.map((h) => [h.curveId ?? h.handle, h]));
const models = Object.entries(CURVES)
  .filter(([id]) => byHandle[id])
  .map(([id, db]) => ({ id, b: byHandle[id].brand, n: byHandle[id].name, db }))
  .sort((a, b) => (a.b + a.n).localeCompare(b.b + b.n));
// TWO SOURCES, never merged onto one axis.
//   ours    — Warren Labs, miniDSP EARS Pro. The product. Default.
//   archive — the HeadRoom HMS II.3 set. Development reference, opt-in, a DIFFERENT fixture.
// A switch rather than a merge, so "two fixtures never share an axis" is enforced by the data model
// instead of by a caption. See MEASUREMENT-PIPELINE.md §4.1 / §5.1.
const ours = MEASUREMENTS.map((m) => ({ id: m.id, b: m.b, n: m.n, db: m.db }));
const PAYLOAD = { grid: GRID_HZ, sources: { ours, archive: models }, targets: REFERENCES };
---

<Layout
  title="Measurements · Warren Labs"
  description="Warren Labs headphone measurements, made on our own miniDSP EARS Pro. Raw, level-matched, and published whatever they say."
>
  <Nav />

  <main id="app" class="app">
    <aside>
      <div class="pane">
        <label class="src" title="The HeadRoom archive is a different fixture, kept as a development reference. Switching source replaces the list — the two are never plotted on one axis.">
          <input type="checkbox" id="src-archive" />
          <span>Show HeadRoom archive</span>
        </label>
        <input class="search" id="q" type="search" placeholder="Search…" autocomplete="off" aria-label="Search headphones" />
        <div class="list" id="list" role="listbox" aria-multiselectable="true"></div>
      </div>
    </aside>

    <div class="gwrap">
      <div class="bar">
        <div class="seg" role="tablist" aria-label="View mode">
          <button id="m-ov" class="on" role="tab" aria-selected="true">Overlay</button>
          <button id="m-df" role="tab" aria-selected="false">Difference</button>
        </div>
        <label class="toggle" id="band-t">
          <input type="checkbox" id="band" /><span>Seating variance</span>
        </label>
        <label class="align" title="A smooth reference SHAPE drawn behind the selection — not the app\u2019s voice-match target, which deliberately carries the rig\u2019s own artifacts and would read as a spike here.">
          <span>Reference</span>
          <select id="target">
            <option value="">None</option>
            <option value="kemar-diffuse-field">Diffuse field</option>
            <option value="in-room-preference">In-room preference</option>
          </select>
        </label>
        <label class="align" title="Vertical span. LOCK a scale so the same headphone renders identically between sessions and between exported images — Auto rescales to whatever is selected.">
          <span>Scale</span>
          <select id="yscale">
            <option value="auto">Auto</option>
            <option value="20">±20 dB</option>
            <option value="30" selected>±30 dB</option>
            <option value="40">±40 dB</option>
          </select>
        </label>
        <label class="align" title="Display smoothing. The stored data is never changed.">
          <span>Smooth</span>
          <select id="smooth">
            <option value="3">1/3 oct</option>
            <option value="6">1/6 oct</option>
            <option value="12" selected>1/12 oct</option>
            <option value="24">1/24 oct</option>
            <option value="0">None</option>
          </select>
        </label>
        <label class="align" title="What the curves are levelled against. A band is a fairer anchor than a single frequency.">
          <span>Align</span>
          <select id="align">
            <option value="mid">250–4 kHz</option>
            <option value="1k">1 kHz</option>
            <option value="bass">20–200 Hz</option>
          </select>
        </label>
        <div class="hint" id="hint"></div>
        <div class="share">
          <button class="sbtn" id="copy-link" title="Copy a link to this exact comparison">Copy link</button>
          <button class="sbtn" id="save-png" title="Download this graph as an image">Save image</button>
        </div>
      </div>

      <div class="canvas-box">
        <canvas id="cv"></canvas>
        <div class="tip" id="tip"></div>
      </div>

      <div class="legend" id="legend"></div>
      <p class="caption" id="caption"></p>

      <details class="method">
        <summary>Method &amp; limits</summary>
        <div class="mgrid">
          <div>
            <h4>What this is</h4>
            <p>
              <b>Our own measurements</b>, made here on a <b>miniDSP EARS&nbsp;Pro</b> — rig,
              operator, unit and pad state recorded for every curve. Raw, not diffuse-field
              compensated, and published whatever they say. The corpus is small and growing: we
              are measuring from scratch rather than inheriting somebody else&rsquo;s numbers.
            </p>
          </div>
          <div>
            <h4>The HeadRoom archive</h4>
            <p>
              A separate set of 40 curves measured years ago on a <b>Head Acoustics HMS&nbsp;II.3</b>,
              kept as a <b>development reference</b> and switched off by default. A different fixture
              is a different coordinate system, so the two <b>never share an axis</b> — this page
              shows one or the other, never a blend, and a count covers one rig or the other.
            </p>
          </div>
          <div>
            <h4>How much to trust a line</h4>
            <p>
              Re-seating moves it: <b>±0.37&nbsp;dB</b> from 200&nbsp;Hz–1&nbsp;kHz, <b>±3.87&nbsp;dB</b>
              by 12–20&nbsp;kHz. Turn the band on. Don't read fine treble detail here.
            </p>
          </div>
          <div>
            <h4>Open headphones read bass-light</h4>
            <p>
              That's the fixture's seal leak, not the headphone. It cancels between headphones
              that seal alike, and <b>doesn't</b> between a sealed one and an open one.
            </p>
          </div>
        </div>
      </details>
    </div>
  </main>

  <Feedback surface="graphs" />
</Layout>

<style>
  :root { --s1:#cb7d28; --s2:#4a97e1; --s3:#3daa6d; --s4:#d16c96; --s5:#9f7dd8; --s6:#10a6ad; }

  /* `.gate` and `.app` both set `display`, which beats the UA sheet's `[hidden]{display:none}`
     — so toggling the hidden attribute alone leaves both on screen at once. */
  [hidden] { display: none !important; }

  /* ---------- gate ---------- */
  .gate { min-height: calc(100vh - var(--wl-head-h)); display: grid; place-items: center; padding: 40px 20px; }
  .gate-card { max-width: 460px; text-align: center; }
  .gate-card .eyebrow {
    font-family: var(--mono); font-size: 10px; letter-spacing: 0.22em; text-transform: uppercase;
    color: var(--accent); display: block; margin-bottom: 18px;
  }
  .gate-card h1 { font-family: var(--serif); font-size: clamp(34px, 6vw, 52px); line-height: 1.06; font-weight: 400; }
  .gate-sub { color: var(--muted); margin: 18px 0 30px; line-height: 1.6; }
  .gate-form { display: flex; gap: 8px; }
  .gate-form input {
    flex: 1; background: var(--bg); border: 1px solid var(--line); border-radius: 10px;
    padding: 11px 13px; color: var(--text); font-family: var(--sans); font-size: 14px; min-width: 0;
  }
  .gate-form input:focus { outline: none; border-color: var(--accent-line); box-shadow: 0 0 0 3px var(--accent-dim); }
  .gate-form button {
    background: var(--accent); color: var(--on-accent); border: 0; border-radius: 10px;
    padding: 11px 18px; font-family: var(--sans); font-weight: 600; font-size: 14px; cursor: pointer; white-space: nowrap;
  }
  .gate-form button.ghost { background: none; border: 1px solid var(--line); color: var(--text); font-weight: 500; }
  .gate-form button.ghost:hover { border-color: var(--muted-2); }
  .gate-err { color: var(--s4); font-size: 13px; margin-top: 10px; }
  .gate-or { position: relative; margin: 24px 0; color: var(--muted-2); font-size: 12px; }
  .gate-or::before { content: ''; position: absolute; inset: 50% 0 auto; height: 1px; background: var(--line-soft); }
  .gate-or span { position: relative; background: var(--bg); padding: 0 12px; }
  .gate-fine { color: var(--muted-2); font-size: 12px; margin-top: 12px; }

  /* ---------- viewer ---------- */
  .app { display: grid; grid-template-columns: 250px 1fr; height: calc(100vh - var(--wl-head-h)); min-height: 0; }
  aside { border-right: 1px solid var(--line-soft); background: var(--surface); min-height: 0; display: flex; }
  .pane { flex: 1; display: flex; flex-direction: column; min-height: 0; padding: 16px 18px 0; }
  /* Source switch. A checkbox rather than a second list, because enabling the archive REPLACES
     the corpus — it never adds to it. */
  .src {
    display: flex; align-items: center; gap: 8px; padding: 8px 10px; margin-bottom: 10px;
    background: var(--surface); border: 1px solid var(--line); border-radius: 9px; cursor: pointer;
    user-select: none;
  }
  .src input { accent-color: var(--accent); margin: 0; cursor: pointer; }
  .src span {
    font-family: var(--mono); font-size: 9px; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--muted-2); line-height: 1.3;
  }
  .src.on span { color: var(--accent); }

  .search {
    width: 100%; background: var(--bg); border: 1px solid var(--line); border-radius: 9px;
    padding: 9px 11px; color: var(--text); font-family: var(--sans); font-size: 13px;
  }
  .search:focus { outline: none; border-color: var(--accent-line); box-shadow: 0 0 0 3px var(--accent-dim); }
  /* Everything inside #list / #legend / #tip is built in JS at runtime, so it never receives
     Astro's scoping attribute and scoped selectors silently don't match — the elements render
     with raw browser defaults. Scope the ancestor, :global() the descendant. */
  .list { flex: 1; overflow-y: auto; margin: 12px -6px 0; padding: 0 6px 16px; }
  .list :global(.brand-h) {
    font-family: var(--mono); font-size: 9px; letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--muted-2); padding: 12px 4px 5px; position: sticky; top: 0; background: var(--surface);
  }
  .list :global(.row) { display: flex; align-items: center; gap: 9px; padding: 6px 8px; border-radius: 7px; cursor: pointer; user-select: none; }
  .list :global(.row:hover) { background: var(--raise); }
  .list :global(.row .sw) { width: 9px; height: 9px; border-radius: 2px; border: 1px solid var(--muted-2); flex: none; }
  .list :global(.row.on .sw) { border-color: transparent; }
  .list :global(.row .nm) { font-size: 12.5px; color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .list :global(.row.on .nm) { color: var(--text); font-weight: 500; }
  .list :global(.row.dis) { opacity: 0.32; cursor: not-allowed; }
  .list :global(.empty) { padding: 20px 4px; color: var(--muted-2); font-size: 12.5px; line-height: 1.5; }

  .gwrap { display: flex; flex-direction: column; min-height: 0; padding: 16px 20px 0; }
  .bar { display: flex; align-items: center; gap: 8px; flex: none; padding-bottom: 12px; }
  .seg { display: flex; background: var(--surface); border: 1px solid var(--line); border-radius: 9px; padding: 2px; gap: 2px; }
  .seg button {
    background: none; border: 0; color: var(--muted); font-family: var(--mono); font-size: 9.5px;
    letter-spacing: 0.14em; text-transform: uppercase; padding: 6px 12px; border-radius: 7px; cursor: pointer;
  }
  .seg button:hover { color: var(--text); }
  .seg button.on { background: var(--accent); color: var(--on-accent); font-weight: 500; }
  .toggle {
    display: flex; align-items: center; gap: 7px; background: var(--surface); border: 1px solid var(--line);
    border-radius: 9px; padding: 7px 11px; cursor: pointer; user-select: none;
  }
  .toggle input { accent-color: var(--accent); margin: 0; cursor: pointer; }
  .toggle span { font-family: var(--mono); font-size: 9.5px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
  .toggle.on span { color: var(--text); }
  .hint { margin-left: auto; font-size: 11.5px; color: var(--muted-2); font-style: italic; }
  /* Share: the reason a comparison ends up in a forum thread instead of dying in a tab. */
  .align { display: flex; align-items: center; gap: 7px; background: var(--surface); border: 1px solid var(--line); border-radius: 9px; padding: 4px 8px 4px 11px; flex: none; }
  .align span { font-family: var(--mono); font-size: 9.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); }
  .align select { background: none; border: 0; color: var(--text); font-family: var(--mono); font-size: 10px; cursor: pointer; padding: 3px 2px; }
  .align select:focus-visible { outline: none; }

  .share { display: flex; gap: 6px; flex: none; }
  .sbtn {
    background: var(--surface); border: 1px solid var(--line); color: var(--muted);
    font-family: var(--mono); font-size: 9.5px; letter-spacing: 0.14em; text-transform: uppercase;
    padding: 7px 11px; border-radius: 9px; cursor: pointer; white-space: nowrap;
    transition: color .14s, border-color .14s;
  }
  .sbtn:hover { color: var(--text); border-color: var(--muted-2); }
  .sbtn:focus-visible { outline: none; border-color: var(--accent-line); box-shadow: 0 0 0 3px var(--accent-dim); }
  .sbtn[disabled] { opacity: .4; cursor: not-allowed; }

  .canvas-box { position: relative; flex: 1; min-height: 0; background: var(--wl-graph-bg); border: 1px solid var(--line-soft); border-radius: 14px; overflow: hidden; }
  canvas { display: block; width: 100%; height: 100%; }
  .tip {
    position: absolute; pointer-events: none; opacity: 0; transition: opacity 0.09s;
    background: var(--surface); border: 1px solid var(--line); border-radius: 9px;
    padding: 9px 11px; font-family: var(--mono); font-size: 11px; line-height: 1.65; white-space: nowrap; z-index: 5;
  }
  .tip :global(.th) { color: var(--muted-2); font-size: 9px; letter-spacing: 0.14em; text-transform: uppercase; margin-bottom: 5px; }
  .tip :global(.tr) { display: flex; align-items: center; gap: 7px; color: var(--text); }
  .tip :global(.tr i) { width: 8px; height: 8px; border-radius: 2px; flex: none; }
  .tip :global(.tr b) { margin-left: auto; padding-left: 14px; font-weight: 500; font-variant-numeric: tabular-nums; }

  .legend { display: flex; flex-wrap: wrap; gap: 8px 18px; padding: 12px 2px; flex: none; min-height: 40px; align-items: center; }
  .legend :global(.lg) { display: flex; align-items: center; gap: 7px; font-size: 12px; color: var(--text); }
  .legend :global(.lg i) { width: 13px; height: 2.5px; border-radius: 2px; flex: none; }
  .legend :global(.lg .x) {
    color: var(--muted-2); cursor: pointer; font-size: 15px; line-height: 1; border: 0;
    background: none; padding: 0 2px; font-family: var(--sans); appearance: none;
  }
  .legend :global(.lg .x:hover) { color: var(--text); }
  /* Auto-generated plain-English statement of what's on screen. Cheap, and it removes the main
     way a measurement graph gets misread: not knowing what it was referenced to. */
  .legend :global(.hear) {
    margin-left: auto; flex: none; background: var(--accent); color: var(--on-accent);
    text-decoration: none; font-family: var(--sans); font-weight: 600; font-size: 12.5px;
    padding: 6px 13px; border-radius: 8px; white-space: nowrap;
  }
  .legend :global(.hear:hover) { background: var(--accent-soft); }

  .caption { flex: none; padding: 0 2px 12px; font-size: 12px; line-height: 1.55; color: var(--muted); max-width: 78ch; }
  .caption :global(b) { color: var(--text); font-weight: 500; }

  .legend :global(.lg-band) { display: flex; align-items: center; gap: 7px; font-size: 11.5px; color: var(--muted-2); }
  .legend :global(.lg-band i) { width: 13px; height: 9px; border-radius: 2px; background: rgba(232, 235, 237, 0.13); border: 1px solid rgba(232, 235, 237, 0.2); flex: none; }

  .method { flex: none; border-top: 1px solid var(--line-soft); }
  .method summary {
    padding: 11px 0; cursor: pointer; font-family: var(--mono); font-size: 9.5px;
    letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); list-style: none;
  }
  .method summary::-webkit-details-marker { display: none; }
  .method summary::before { content: '▶ '; font-size: 8px; }
  .method[open] summary::before { content: '▼ '; }
  .method summary:hover { color: var(--text); }
  .mgrid { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 18px 28px; padding-bottom: 18px; }
  .mgrid h4 { font-family: var(--mono); font-size: 9px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--accent); margin-bottom: 6px; font-weight: 400; }
  .mgrid p { font-size: 12.5px; line-height: 1.6; color: var(--muted); }
  .mgrid b { color: var(--text); font-weight: 500; }

  /* Difference mode: two numbered slots (1 = yours, 2 = target), a swap control, and any extra
     picks as removable chips. Built in JS at runtime, so scope the ancestor and :global the rest. */
  .legend :global(.diff-wrap) { display: flex; flex-direction: column; gap: 9px; width: 100%; }
  .legend :global(.diff-pair) { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .legend :global(.diff-slot) {
    display: flex; align-items: center; gap: 9px; max-width: 340px;
    background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 6px 13px 6px 7px;
  }
  .legend :global(.diff-slot.empty) { border-style: dashed; background: none; }
  .legend :global(.diff-slot .badge) {
    width: 21px; height: 21px; border-radius: 50%; flex: none; display: grid; place-items: center;
    font-family: var(--mono); font-size: 11px; font-weight: 600; background: var(--accent); color: var(--on-accent);
  }
  .legend :global(.diff-slot.empty .badge) { background: var(--raise); color: var(--muted-2); }
  .legend :global(.diff-slot .role) {
    font-family: var(--mono); font-size: 9px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted-2); flex: none;
  }
  .legend :global(.diff-slot .dp-name) {
    font-size: 13px; color: var(--text); font-weight: 500; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .legend :global(.diff-slot.empty .dp-name) { color: var(--muted-2); font-weight: 400; font-style: italic; }
  .legend :global(.swap) {
    width: 30px; height: 30px; border-radius: 8px; flex: none; display: grid; place-items: center;
    background: var(--surface); border: 1px solid var(--line); color: var(--muted); font-size: 15px; cursor: pointer;
  }
  .legend :global(.swap:hover:not(:disabled)) { color: var(--text); border-color: var(--muted-2); }
  .legend :global(.swap:disabled) { opacity: 0.32; cursor: default; }
  .legend :global(.diff-note) { display: flex; align-items: center; gap: 8px; font-size: 12.5px; color: var(--muted); }
  .legend :global(.diff-note i) { width: 14px; height: 3px; border-radius: 2px; flex: none; }
  .legend :global(.diff-note b) { color: var(--text); font-weight: 600; }
  .legend :global(.diff-extra) { display: flex; align-items: center; flex-wrap: wrap; gap: 7px; }
  .legend :global(.diff-extra .ex-label) {
    font-family: var(--mono); font-size: 9px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted-2);
  }
  .legend :global(.ex-chip) {
    display: inline-flex; align-items: center; gap: 4px;
    background: var(--raise); border: 1px solid var(--line-soft); border-radius: 20px; padding: 3px 5px 3px 11px; font-size: 12px; color: var(--muted);
  }
  .legend :global(.ex-chip .x) {
    color: var(--muted-2); cursor: pointer; font-size: 15px; line-height: 1; border: 0; background: none; padding: 0 2px 2px; font-family: var(--sans); appearance: none;
  }
  .legend :global(.ex-chip .x:hover) { color: var(--text); }

  /* Mobile. A forum link opened on a phone is the single most common way someone arrives here, so
     this is the layout that matters most, not a fallback. PLOT FIRST: the graph is the thing they
     followed the link for; the picker sits under it rather than pushing it off-screen. */
  @media (max-width: 760px) {
    .app { grid-template-columns: 1fr; height: auto; display: flex; flex-direction: column; }
    .gwrap { order: 1; padding: 12px 14px 0; }
    aside { order: 2; border-right: 0; border-top: 1px solid var(--line-soft); }
    .pane { padding: 12px 14px 0; }
    .list { max-height: 46vh; }
    /* Taller than it is wide would waste a phone screen; this is a readable landscape-ish window
       that still leaves the picker reachable with a thumb. */
    .canvas-box { height: 46vh; min-height: 240px; }

    /* The toolbar has four control groups now. Let it wrap instead of overflowing, and drop the
       hint — on a phone the legend underneath already says how many are selected. */
    .bar { flex-wrap: wrap; gap: 6px; }
    .hint { display: none; }
    .align { margin-left: auto; }
    .share { width: 100%; }
    .sbtn { flex: 1; }
    .caption { font-size: 12.5px; padding-bottom: 16px; }
    .legend :global(.hear) { margin-left: 0; width: 100%; text-align: center; }
  }
  /* Landscape phone: give the plot the whole viewport — this is how you actually read a graph on a
     phone, and it's the gesture people already know. */
  @media (max-width: 900px) and (orientation: landscape) {
    aside { display: none; }
    .canvas-box { height: calc(100vh - var(--wl-head-h) - 92px); }
  }
</style>

{/* wl-plot must be parsed before the define:vars block below, which is forced inline and so cannot
    import. Vendored into public/ from wl-web by tools/vendor.mjs. */}
<script is:inline src={WL_ASSETS.plot}></script>

<script define:vars={{ PAYLOAD }}>
  // Colours now come from wl-web tokens rather than the hex literals that used to live here, so the
  // plot follows light/dark like the rest of the page. Re-read on every theme change: CSS variables
  // update instantly for DOM, but a canvas has to be redrawn to notice.
  let TOK = WLPlot.readTokens();
  let SERIES = TOK.series;
  const MAX = SERIES.length;

  // Seating variance: two MEASURED anchors, interpolated between, nothing below 200 Hz —
  // absence, not zero.
  const SD_LO_HZ = 200, SD_LO = 0.37, SD_HI_HZ = 12000, SD_HI = 3.87;
  const sdAt = (hz) => {
    if (hz < SD_LO_HZ) return null;
    if (hz <= 1000) return SD_LO;
    if (hz >= SD_HI_HZ) return SD_HI;
    return SD_LO + (Math.log(hz / 1000) / Math.log(SD_HI_HZ / 1000)) * (SD_HI - SD_LO);
  };

  const F0 = 20, F1 = 20000;
  const TICKS = [20, 50, 100, 200, 500, 1000, 2000, 5000, 10000, 20000];
  const fmtHz = (f) => (f >= 1000 ? f / 1000 + 'k' : String(f));
  const $ = (id) => document.getElementById(id);

  // The dataset is inlined at build time (see the frontmatter), so there is nothing to fetch
  // and nothing to unlock. Boot straight into the viewer at the end of this script.

  // ---------- viewer ----------
  let MODELS = [], GRID = [], DB = new Map(), SMOOTH = new Map(), TARGETS = {};
  let SOURCES = {}, source = 'ours';   // 'ours' = EARS Pro (default) | 'archive' = HeadRoom HMS II.3
  let mode = 'overlay', showBand = false;
  let smoothOct = 12;          // 1/N octave; 0 = off
  let yScale = 30;             // 'auto' or a ±dB span. A LOCKED scale is what makes two exported
                               // images of the same headphone comparable — auto-scaling silently
                               // rescales the plot to whatever else happens to be selected.
  let targetId = '';           // reference curve drawn behind the selection
  let sel = [];
  const usedSlots = new Set();
  let hoverX = null, plot = null;
  const cv = $('cv'), tip = $('tip');
  const ctx = cv.getContext('2d');

  // 1/12-octave gaussian smoothing, for DISPLAY only. The stored data is untouched, and the
  // smoothing window is far finer than the 0.37 dB seating floor, so this removes rendering
  // jaggedness without inventing or hiding anything real.
  function smoothCurve(db, oct) {
    oct = oct === undefined ? smoothOct : oct;
    if (!oct) return db.slice();                 // "None" — the stored points, unsmoothed
    const ln = GRID.map(Math.log);
    const sig = Math.log(Math.pow(2, 1 / oct)) / 2;
    return db.map((_, i) => {
      let num = 0, den = 0;
      for (let j = 0; j < db.length; j++) {
        const d = (ln[j] - ln[i]) / sig;
        if (Math.abs(d) > 3) continue;
        const w = Math.exp(-0.5 * d * d);
        num += w * db[j];
        den += w;
      }
      return num / den;
    });
  }
  // Renders from the inlined payload.
  // Load ONE source into the viewer. Wipes the previous corpus rather than adding to it: the two
  // rigs are different coordinate systems, and leaving stale curves selected across a switch is
  // exactly how a mixed-baseline comparison would get made by accident.
  function loadSource(which) {
    source = which;
    sel.length = 0;
    usedSlots.clear();
    DB.clear();
    SMOOTH.clear();
    alignCache.clear();
    const list = SOURCES[which] || [];
    MODELS = list.map((m) => ({ id: m.id, brand: m.b, name: m.n }));
    for (const m of list) {
      DB.set(m.id, m.db);
      SMOOTH.set(m.id, smoothCurve(m.db));
    }
  }

  function boot(a) {
    GRID = a.grid;
    TARGETS = a.targets || {};
    SOURCES = a.sources || {};
    loadSource('ours');
    // A shared link wins over the house default — arriving from a forum post must show the
    // comparison that was linked, not ours. Only fall back when there's nothing in the URL.
    restoreFromUrl();
    // Fall back on the OUTCOME, not on what restore claimed. If any part of the restore misbehaves
    // the visitor must still land on a usable page rather than an empty or half-drawn one.
    if (!sel.length) {
      // Default view. `restoring` is held true for the same reason the URL path holds it: toggle()
      // calls syncUrl(), so without it the house default stamps ?h=... into a visitor's address bar
      // before they have chosen anything — and each toggle rewrites history mid-loop, which is what
      // was silently costing the second curve here.
      restoring = true;
      try {
        // ONE curve by default, deliberately. The page is an invitation to compare, and opening
        // with a single line makes the picker the obvious next move rather than something to undo.
        // (It also sidesteps a boot-order quirk where a second default selection didn't take; the
        // URL-restore path, manual selection and sharing all handle multiples correctly.)
        const first = MODELS.find((m) => m.id === 'sennheiser-hd-800') || MODELS[0];
        if (first) toggle(first.id);
      } catch (e) {
        console.error('default selection', e);
      } finally {
        restoring = false;
      }
    }
    renderList(); renderLegend(); renderCaption(); draw();
  }

  // Alignment. The stored curves are normalized at 1 kHz, but a single-point anchor forces two
  // curves to agree exactly there and visually exaggerates everything either side of it — which is
  // why bass comparisons read badly at 1 kHz. Aligning over a BAND (GraphWorks uses 250-4000 Hz) is
  // the more honest anchor. Implemented as a display-time offset; the stored data never changes.
  const ALIGN = {
    '1k':   { label: '1 kHz',        lo: 1000, hi: 1000 },
    'mid':  { label: '250–4 kHz',    lo: 250,  hi: 4000 },
    'bass': { label: '20–200 Hz',    lo: 20,   hi: 200  },
  };
  let alignMode = 'mid';

  function resmoothAll() {
    for (const [id, db] of DB) SMOOTH.set(id, smoothCurve(db));
    alignCache.clear();
  }

  const rawCurve = (id) => SMOOTH.get(id) ?? DB.get(id);

  // Mean level of a curve across the alignment band, in GRID index space.
  function alignOffset(id) {
    const d = rawCurve(id);
    if (!d) return 0;
    const a = ALIGN[alignMode];
    if (a.lo === a.hi) {
      let best = 0, bd = Infinity;
      for (let i = 0; i < GRID.length; i++) { const q = Math.abs(Math.log(GRID[i] / a.lo)); if (q < bd) { bd = q; best = i; } }
      return d[best];
    }
    let s = 0, n = 0;
    for (let i = 0; i < GRID.length; i++) if (GRID[i] >= a.lo && GRID[i] <= a.hi) { s += d[i]; n++; }
    return n ? s / n : 0;
  }

  // Everything downstream (draw, hover, difference) reads through here, so alignment applies once.
  // The target goes through the SAME alignment as the headphones. If it didn't, the reference line
  // would sit at a fixed offset while the curves moved under it, which is worse than having no
  // reference at all — it would look authoritative and be wrong.
  // These are rig-agnostic reference SHAPES (references.dat), not measured on either fixture, so
  // unlike the app's voice-match targets they are legitimate over both corpora. Normalised the same
  // way as the curves they sit behind, and always drawn dashed + dimmed.
  const targetUsable = () => true;

  function targetCurve() {
    const t = targetId && targetUsable() && TARGETS[targetId];
    if (!t) return null;
    const key = '__target__' + targetId;
    if (!DB.has(key)) { DB.set(key, t.db); SMOOTH.set(key, smoothCurve(t.db)); }
    return curve(key);
  }

  const alignCache = new Map();
  function curve(id) {
    const k = id + '|' + alignMode;
    if (alignCache.has(k)) return alignCache.get(k);
    const d = rawCurve(id);
    if (!d) return d;
    const off = alignOffset(id);
    const out = d.map((v) => v - off);
    alignCache.set(k, out);
    return out;
  }

  function dbAt(id, hz) {
    const d = curve(id);
    if (!d) return 0;
    if (hz <= GRID[0]) return d[0];
    if (hz >= GRID[GRID.length - 1]) return d[d.length - 1];
    let lo = 0, hi = GRID.length - 1;
    while (hi - lo > 1) { const m = (lo + hi) >> 1; if (GRID[m] <= hz) lo = m; else hi = m; }
    const t = Math.log(hz / GRID[lo]) / Math.log(GRID[hi] / GRID[lo]);
    return d[lo] + t * (d[hi] - d[lo]);
  }

  const meta = (id) => MODELS.find((m) => m.id === id);
  const label = (id) => { const m = meta(id); return m ? m.brand + ' ' + m.name : id; };
  const colourOf = (s) => SERIES[s.slot];

  function toggle(id) {
    const i = sel.findIndex((s) => s.id === id);
    if (i >= 0) { usedSlots.delete(sel[i].slot); sel.splice(i, 1); }
    else {
      if (sel.length >= MAX) return;
      let slot = 0;
      while (usedSlots.has(slot)) slot++;
      usedSlots.add(slot);
      sel.push({ id, slot });
    }
    renderList(); renderLegend(); renderCaption(); draw(); syncUrl();
  }

  // ---------- shareable state ----------
  //
  // A comparison you can't link to is a comparison nobody quotes. This is how a graph gets posted
  // into a forum thread, and it is also how a /products/{handle} page can hand off to this tool
  // with that model already selected. NOT a data export: the URL names which curves are on screen,
  // it doesn't carry any measured values. Rule 1 in data-provenance.md is untouched.
  //
  // Order in `h` is significant — it IS the Difference-mode "yours, then target" pairing.
  let restoring = false;
  function syncUrl() {
    if (restoring) return;
    const p = new URLSearchParams();
    if (sel.length) p.set('h', sel.map((s) => s.id).join(','));
    if (mode !== 'overlay') p.set('m', mode);
    if (showBand) p.set('band', '1');
    if (alignMode !== 'mid') p.set('a', alignMode);
    if (source !== 'ours') p.set('src', source);
    if (targetId) p.set('t', targetId);
    if (yScale !== 30) p.set('y', String(yScale));
    if (smoothOct !== 12) p.set('s', String(smoothOct));
    const q = p.toString();
    // replaceState, not pushState: dragging through a dozen headphones shouldn't bury the visitor's
    // real history under a dozen back-button steps.
    history.replaceState(null, '', q ? '?' + q : location.pathname);
  }

  function restoreFromUrl() {
    const p = new URLSearchParams(location.search);
    const ids = (p.get('h') || '').split(',').map((s) => s.trim()).filter(Boolean);
    if (!ids.length) return;
    restoring = true;
    try {

    // VIEW SETTINGS FIRST, then the curves. Two reasons, and the second is a bug I shipped:
    //   1. Correctness — toggling a curve draws it, so applying smoothing/scale afterwards means
    //      the first paints happen at the wrong settings and have to be redone.
    //   2. Robustness — these used to run AFTER the toggle loop, so anything that threw part-way
    //      through took the whole restore with it: a shared link came back with one headphone and
    //      none of its settings. Each step is now independently guarded, so a single bad parameter
    //      degrades to "that one setting was ignored" instead of silently gutting the link.
    const step = (what, fn) => { try { fn(); } catch (e) { console.error('restore: ' + what, e); } };

    // Source first: the ids below only exist in one corpus, and loadSource() wipes the selection.
    step('source', () => {
      if (p.get('src') === 'archive') {
        loadSource('archive');
        $('src-archive').checked = true;
        $('src-archive').closest('.src').classList.add('on');
      }
    });
    step('target', () => {
      const tg = p.get('t');
      if (tg && TARGETS[tg]) { targetId = tg; $('target').value = tg; }
    });
    step('scale', () => {
      const ys = p.get('y');
      if (ys) { yScale = ys === 'auto' ? 'auto' : Number(ys); $('yscale').value = ys; }
    });
    step('smoothing', () => {
      const sm = p.get('s');
      if (sm !== null && sm !== '' && !Number.isNaN(Number(sm))) {
        smoothOct = Number(sm); $('smooth').value = sm; resmoothAll();
      }
    });
    step('align', () => {
      const am = p.get('a');
      if (am && ALIGN[am]) { alignMode = am; $('align').value = am; alignCache.clear(); }
    });
    step('band', () => {
      if (p.get('band') === '1') { showBand = true; $('band').checked = true; $('band-t').classList.add('on'); }
    });

    // Now the selection. Guarded per id for the same reason — one unknown handle in a pasted link
    // must not cost the reader the rest of the comparison.
    for (const id of ids.slice(0, MAX)) step('headphone ' + id, () => { if (DB.has(id)) toggle(id); });
    step('mode', () => { if (p.get('m') === 'difference') setMode('difference'); });
    } finally {
      // MUST reset even if a step escapes: a stuck `restoring` silently disables syncUrl for the
      // rest of the session, so every later change stops appearing in the URL and Copy link starts
      // handing out a stale address. That failure is invisible until someone shares a wrong link.
      restoring = false;
    }
  }

  async function copyLink(btn) {
    syncUrl();
    const done = (msg) => { btn.textContent = msg; setTimeout(() => (btn.textContent = 'Copy link'), 1600); };
    try {
      await navigator.clipboard.writeText(location.href);
      done('Copied');
    } catch (e) {
      // Clipboard API needs a secure context and can be permission-blocked. Select the URL so the
      // visitor can still copy it by hand rather than getting a dead button.
      const t = document.createElement('input');
      t.value = location.href; document.body.appendChild(t); t.select();
      try { document.execCommand('copy'); done('Copied'); } catch (_) { done('Press ⌘C'); }
      setTimeout(() => t.remove(), 100);
    }
  }

  // ---------- watermarked PNG ----------
  //
  // A RENDER, not a data export — the same pixels already on screen, plus attribution baked in so
  // the image stays sourced when it travels. Drawn at 2x on an offscreen canvas (a screenshot of a
  // CSS-pixel canvas is soft on a forum's retina display), always on the plot's own background so a
  // light-theme export doesn't arrive transparent, and always naming the fixture.
  function exportPng() {
    const SCALE = 2, W = 1400, H = 800, PAD = 28, FOOT = 54;
    const off = document.createElement('canvas');
    off.width = W * SCALE; off.height = (H + FOOT) * SCALE;
    const c = off.getContext('2d');
    c.setTransform(SCALE, 0, 0, SCALE, 0, 0);
    c.fillStyle = TOK.bg || '#0f1012';
    c.fillRect(0, 0, W, H + FOOT);

    // Re-run the real draw() against the offscreen context by temporarily swapping the module-level
    // ctx/plot geometry. Cheaper and far less drift-prone than a second rendering path that would
    // quietly diverge from the on-screen one.
    drawInto(c, PAD, PAD, W - PAD * 2, H - PAD * 2);

    c.font = '500 13px ' + TOK.mono;
    c.textAlign = 'left'; c.textBaseline = 'middle';
    c.fillStyle = TOK.axis;
    c.fillText((source === 'archive'
        ? 'HeadRoom archive · Head Acoustics HMS II.3 · development reference'
        : 'Warren Labs · miniDSP EARS Pro') + '  ·  raw, level-matched', PAD, H + FOOT / 2 - 8);
    c.fillStyle = TOK.anno;
    c.font = '400 11px ' + TOK.mono;
    c.fillText(sel.map((s) => label(s.id)).join('   ·   ').slice(0, 120), PAD, H + FOOT / 2 + 11);
    c.textAlign = 'right';
    c.font = '600 14px ' + TOK.mono;
    c.fillStyle = TOK.axis;
    c.fillText('warrenlabs.com/graphs', W - PAD, H + FOOT / 2);

    off.toBlob((blob) => {
      if (!blob) return;
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      const names = sel.map((s) => label(s.id).replace(/[^a-z0-9]+/gi, '-').toLowerCase()).join('_vs_');
      a.href = url; a.download = (names || 'warren-labs-measurement').slice(0, 90) + '.png';
      a.click();
      setTimeout(() => URL.revokeObjectURL(url), 4000);
    }, 'image/png');
  }

  // Difference mode: flip which pick is "yours" (1) and which is the "target" (2). The correction
  // curve inverts; saves reselecting when you picked them in the wrong order.
  function swapPair() {
    if (sel.length < 2) return;
    const t = sel[0]; sel[0] = sel[1]; sel[1] = t;
    renderLegend(); renderCaption(); draw();
  }

  function renderList() {
    const q = $('q').value.trim().toLowerCase();
    const hit = MODELS.filter((m) => !q || (m.brand + ' ' + m.name).toLowerCase().includes(q));
    const list = $('list');
    list.innerHTML = '';
    if (!hit.length) { list.innerHTML = '<div class="empty">Nothing matches that.</div>'; return; }
    const full = sel.length >= MAX;
    let brand = null;
    const frag = document.createDocumentFragment();
    for (const m of hit) {
      if (m.brand !== brand) {
        brand = m.brand;
        const h = document.createElement('div');
        h.className = 'brand-h'; h.textContent = brand;
        frag.appendChild(h);
      }
      const on = sel.find((s) => s.id === m.id);
      const row = document.createElement('div');
      row.className = 'row' + (on ? ' on' : '') + (!on && full ? ' dis' : '');
      row.setAttribute('role', 'option');
      row.setAttribute('aria-selected', on ? 'true' : 'false');
      row.title = m.brand + ' ' + m.name;
      const sw = document.createElement('span');
      sw.className = 'sw';
      if (on) sw.style.background = colourOf(on);
      const nm = document.createElement('span');
      nm.className = 'nm'; nm.textContent = m.name;
      row.append(sw, nm);
      if (on || !full) row.addEventListener('click', () => toggle(m.id));
      frag.appendChild(row);
    }
    list.appendChild(frag);
  }

  // The caption is the cheapest defence against a misread graph: it states the fixture, what the
  // curves were levelled against, and — in Difference mode — which direction the correction runs.
  function renderCaption() {
    const el = $('caption');
    if (!sel.length) { el.textContent = ''; return; }
    const a = ALIGN[alignMode];
    const names = sel.map((s) => '<b>' + label(s.id) + '</b>');
    let body;
    if (mode === 'difference' && sel.length >= 2) {
      body = 'the correction that would make ' + names[0] + ' measure like ' + names[1];
    } else {
      body = 'measurements of ' + (names.length === 1 ? names[0]
        : names.slice(0, -1).join(', ') + ' and ' + names[names.length - 1]);
    }
    el.innerHTML =
      'This shows ' + body +
      (source === 'archive'
        ? ', from the HeadRoom archive on a <b>Head Acoustics HMS II.3</b> (development reference), L/R averaged'
        : ', measured here on a <b>miniDSP EARS Pro</b>') +
      ', levelled over <b>' + a.label + '</b>' +
      (targetId && TARGETS[targetId] && mode !== 'difference'
        ? ', against the <b>' + TARGETS[targetId].name + '</b> reference shape (dashed)' : '') +
      (smoothOct ? ', smoothed 1/' + smoothOct + ' octave' : ', unsmoothed') +
      (showBand && mode !== 'difference' ? ', with the ±1 SD seating band' : '') + '.';
  }

  function renderLegend() {
    const lg = $('legend');
    lg.innerHTML = '';
    if (mode === 'difference') {
      const extras = sel.slice(2);
      $('hint').textContent =
        sel.length === 0 ? 'Pick your headphone, then a target.'
        : sel.length === 1 ? 'Now pick a target.'
        : extras.length ? 'Only the first two are compared.' : '';

      const wrap = document.createElement('div');
      wrap.className = 'diff-wrap';

      // Two always-visible slots so it's clear which pick is yours (1) and which is the target (2).
      const pair = document.createElement('div');
      pair.className = 'diff-pair';
      const makeSlot = (n, role, s, placeholder) => {
        const el = document.createElement('div');
        el.className = 'diff-slot' + (s ? '' : ' empty');
        const b = document.createElement('span'); b.className = 'badge'; b.textContent = n;
        const r = document.createElement('span'); r.className = 'role'; r.textContent = role;
        const nm = document.createElement('span'); nm.className = 'dp-name';
        nm.textContent = s ? label(s.id) : placeholder;
        el.append(b, r, nm);
        return el;
      };
      pair.appendChild(makeSlot('1', 'Yours', sel[0], 'Pick your headphone'));

      const swap = document.createElement('button');
      swap.className = 'swap'; swap.textContent = '⇄';
      swap.title = 'Swap yours / target';
      swap.setAttribute('aria-label', 'Swap which headphone is yours and which is the target');
      swap.disabled = sel.length < 2;
      swap.addEventListener('click', swapPair);
      pair.appendChild(swap);

      pair.appendChild(makeSlot('2', 'Target', sel[1], 'Pick a target'));
      wrap.appendChild(pair);

      if (sel.length >= 2) {
        const note = document.createElement('div');
        note.className = 'diff-note';
        const i = document.createElement('i'); i.style.background = SERIES[0];
        const txt = document.createElement('span');
        txt.innerHTML = `Correction to make <b>${label(sel[0].id)}</b> measure like <b>${label(sel[1].id)}</b>`;
        note.append(i, txt);

        // The bridge. This view already computes exactly what voice-match applies — the delta
        // between two measured curves — so the honest next step isn't another graph, it's hearing
        // it. Until now /graphs and Attune didn't touch at all, which was the biggest missed
        // connection in the line. Carries the pair so the landing page can name it.
        const hear = document.createElement('a');
        hear.className = 'hear';
        hear.href = `/attune?yours=${encodeURIComponent(sel[0].id)}&target=${encodeURIComponent(sel[1].id)}`;
        hear.textContent = 'Hear this →';
        hear.title = `Voice-match ${label(sel[0].id)} to ${label(sel[1].id)} in Attune`;
        note.appendChild(hear);
        wrap.appendChild(note);
      }

      // Anything past the first two stays selected but isn't compared — shown as removable chips,
      // so switching from a multi-overlay into Difference is usable instead of a dead end.
      if (extras.length) {
        const ex = document.createElement('div');
        ex.className = 'diff-extra';
        const exLab = document.createElement('span');
        exLab.className = 'ex-label'; exLab.textContent = 'Set aside';
        ex.appendChild(exLab);
        for (const s of extras) {
          const chip = document.createElement('span');
          chip.className = 'ex-chip';
          const t = document.createElement('span'); t.textContent = label(s.id);
          const x = document.createElement('button');
          x.className = 'x'; x.textContent = '×';
          x.setAttribute('aria-label', 'Remove ' + label(s.id));
          x.addEventListener('click', () => toggle(s.id));
          chip.append(t, x);
          ex.appendChild(chip);
        }
        wrap.appendChild(ex);
      }

      lg.appendChild(wrap);
      return;
    }
    $('hint').textContent = sel.length ? `${sel.length} of ${MAX}` : 'Pick a headphone.';
    for (const s of sel) {
      const el = document.createElement('div');
      el.className = 'lg';
      const i = document.createElement('i'); i.style.background = colourOf(s);
      const t = document.createElement('span'); t.textContent = label(s.id);
      const x = document.createElement('button');
      x.className = 'x'; x.textContent = '×';
      x.setAttribute('aria-label', 'Remove ' + label(s.id));
      x.addEventListener('click', () => toggle(s.id));
      el.append(i, t, x);
      lg.appendChild(el);
    }
    if (targetId && TARGETS[targetId] && mode !== 'difference') {
      const t = document.createElement('div');
      t.className = 'lg-band';
      t.innerHTML = '<i style="background:none;border-top:2px dashed ' + TOK.axis + ';height:0"></i><span>' +
                    TARGETS[targetId].name + ' (reference)</span>';
      lg.appendChild(t);
    }
    if (showBand && sel.length) {
      const b = document.createElement('div');
      b.className = 'lg-band';
      b.innerHTML = '<i></i><span>±1 SD seating variance</span>';
      lg.appendChild(b);
    }
  }

  // Catmull-Rom through the points: the smoothing handles the data, this handles the corners
  // so the line reads as a curve rather than a polyline.
  // Takes ctx explicitly: drawInto() retargets rendering to an offscreen canvas for the PNG export,
  // and a helper that closed over the module-level ctx would silently keep painting the live one —
  // which is exactly the bug that shipped an export with grid and watermark but no curve.
  function strokeSpline(ctx, pts) {
    if (pts.length < 2) return;
    ctx.beginPath();
    ctx.moveTo(pts[0][0], pts[0][1]);
    for (let i = 0; i < pts.length - 1; i++) {
      const p0 = pts[i - 1] ?? pts[i], p1 = pts[i], p2 = pts[i + 1], p3 = pts[i + 2] ?? p2;
      ctx.bezierCurveTo(
        p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6,
        p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6,
        p2[0], p2[1]
      );
    }
    ctx.stroke();
  }

  // draw() paints the on-screen canvas; drawInto() is the same rendering, retargetable to any
  // context and rect so the PNG export reuses it verbatim. One rendering path — a second one would
  // drift out of sync with this one the first time either changed.
  function draw() {
    const dpr = window.devicePixelRatio || 1;
    const box = cv.parentElement.getBoundingClientRect();
    const W = Math.max(1, Math.floor(box.width)), H = Math.max(1, Math.floor(box.height));
    cv.width = W * dpr; cv.height = H * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, W, H);
    const p = drawInto(ctx, 0, 0, W, H, true);
    plot = p;   // only the live canvas records geometry — hover hit-testing reads it
  }

  function drawInto(ctx, OX, OY, W, H, live) {

    // Fixed PERSPECTIVE: the plot's width:height ratio is held constant, so a curve looks the
    // same at any window size — it scales, it never squishes. Fit the largest fixed-ratio plot
    // inside the available area (minus label gutters) and centre it; the slack becomes even
    // letterbox/pillarbox margins. PLOT_AR is the one knob — the graph's width:height shape.
    const GUT_L = 50, GUT_R = 14, GUT_T = 14, GUT_B = 46;   // 46: freq labels + the band strip beneath them
    // Fixed aspect keeps a curve comparable between screenshots, but forcing 1.85 into a phone's
    // width letterboxes it down to a sliver. Relax toward the available box below 620 px.
    const PLOT_AR = W < 620 ? Math.max(1.15, Math.min(1.85, availW / Math.max(1, availH))) : 1.85;
    const availW = W - GUT_L - GUT_R, availH = H - GUT_T - GUT_B;
    if (availW < 40 || availH < 40) return null;
    let pw, ph;
    if (availW / availH > PLOT_AR) { ph = availH; pw = Math.round(ph * PLOT_AR); }
    else { pw = availW; ph = Math.round(pw / PLOT_AR); }
    const L = OX + GUT_L + Math.round((availW - pw) / 2);
    const T = OY + GUT_T + Math.round((availH - ph) / 2);
    if (pw < 40 || ph < 40) return null;

    const diff = mode === 'difference' && sel.length >= 2;
    const active = diff ? sel.slice(0, 2) : sel;

    let lo = -12, hi = 12;
    if (yScale !== 'auto') {
      // Locked: a fixed, symmetric span. Deliberately ignores the data so the plot's vertical
      // meaning is constant across sessions, selections and exported images.
      lo = -Number(yScale); hi = Number(yScale);
    } else if (active.length) {
      let mn = Infinity, mx = -Infinity;
      const scan = (v) => { if (v < mn) mn = v; if (v > mx) mx = v; };
      if (diff) {
        const a = curve(sel[0].id), b = curve(sel[1].id);
        for (let i = 0; i < GRID.length; i++) scan(b[i] - a[i]);
      } else {
        for (const s of active) {
          const d = curve(s.id);
          for (let i = 0; i < d.length; i++) {
            scan(d[i]);
            if (showBand) { const sd = sdAt(GRID[i]); if (sd) { scan(d[i] + sd); scan(d[i] - sd); } }
          }
        }
      }
      const pad = Math.max(2, (mx - mn) * 0.1);
      lo = Math.floor((mn - pad) / 5) * 5; hi = Math.ceil((mx + pad) / 5) * 5;
      if (hi - lo < 20) { const c = (hi + lo) / 2; lo = c - 10; hi = c + 10; }
    }

    const X = (hz) => L + (Math.log(hz / F0) / Math.log(F1 / F0)) * pw;
    const Y = (db) => T + (1 - (db - lo) / (hi - lo)) * ph;

    ctx.lineWidth = 1;
    ctx.strokeStyle = TOK.grid;
    for (const f of TICKS) { const x = Math.round(X(f)) + 0.5; ctx.beginPath(); ctx.moveTo(x, T); ctx.lineTo(x, T + ph); ctx.stroke(); }
    const step = hi - lo > 60 ? 20 : hi - lo > 30 ? 10 : 5;
    for (let d = Math.ceil(lo / step) * step; d <= hi; d += step) {
      const y = Math.round(Y(d)) + 0.5;
      // In Difference mode the 0 dB line means "no correction needed", so it earns extra weight.
      ctx.strokeStyle = d === 0 && diff ? TOK.grid0 : TOK.grid;
      ctx.beginPath(); ctx.moveTo(L, y); ctx.lineTo(L + pw, y); ctx.stroke();
    }

    ctx.fillStyle = TOK.axis;
    ctx.font = '400 10px ' + TOK.mono;
    ctx.textAlign = 'center'; ctx.textBaseline = 'top';
    for (const f of TICKS) ctx.fillText(fmtHz(f), X(f), T + ph + 8);
    ctx.textAlign = 'right'; ctx.textBaseline = 'middle';
    for (let d = Math.ceil(lo / step) * step; d <= hi; d += step) ctx.fillText(d > 0 ? '+' + d : String(d), L - 8, Y(d));

    // Frequency-band strip: the cheapest measurement-literacy feature there is. Tells a first-time
    // reader which part of the sound each region is, without sending them to /learn to find out.
    WLPlot.drawBandLabels(ctx, { x: X, f0: F0, f1: F1 }, { L, T, pw, ph }, TOK, T + ph + 22);

    const wantMsg = mode === 'difference' ? sel.length < 2 : !active.length;
    if (wantMsg) {
      ctx.fillStyle = TOK.axis;
      ctx.font = '400 13px ' + TOK.mono;
      ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
      const msg = mode === 'difference'
        ? (sel.length === 1 ? 'Now pick a target to compare against.' : 'Pick two headphones — yours, then a target.')
        : 'Pick a headphone.';
      ctx.fillText(msg, L + pw / 2, T + ph / 2);
      return { L, T, pw, ph };
    }

    ctx.save();
    ctx.beginPath(); ctx.rect(L, T, pw, ph); ctx.clip();

    if (showBand && !diff) {
      for (const s of active) {
        const d = curve(s.id);
        const up = [], dn = [];
        for (let i = 0; i < GRID.length; i++) {
          const sd = sdAt(GRID[i]);
          if (sd == null) continue;
          up.push([X(GRID[i]), Y(d[i] + sd)]);
          dn.push([X(GRID[i]), Y(d[i] - sd)]);
        }
        if (up.length < 2) continue;
        ctx.beginPath();
        up.forEach((p, i) => (i ? ctx.lineTo(p[0], p[1]) : ctx.moveTo(p[0], p[1])));
        for (let i = dn.length - 1; i >= 0; i--) ctx.lineTo(dn[i][0], dn[i][1]);
        ctx.closePath();
        ctx.fillStyle = colourOf(s) + '26';
        ctx.fill();
      }
    }

    // Reference first, so measured curves sit ON it. Dashed + dimmed: a target is a design
    // opinion, not a measurement, and it should never read as another headphone.
    const tgt = !diff && targetCurve();
    if (tgt) {
      ctx.save();
      ctx.setLineDash([6, 5]);
      ctx.globalAlpha = 0.75;
      ctx.lineWidth = 1.8; ctx.lineJoin = 'round'; ctx.lineCap = 'round';
      ctx.strokeStyle = TOK.axis;
      strokeSpline(ctx, GRID.map((f, i) => [X(f), Y(tgt[i])]));
      ctx.restore();
    }

    ctx.lineWidth = 2; ctx.lineJoin = 'round'; ctx.lineCap = 'round';
    if (diff) {
      const a = curve(sel[0].id), b = curve(sel[1].id);
      ctx.strokeStyle = SERIES[0];
      strokeSpline(ctx, GRID.map((f, i) => [X(f), Y(b[i] - a[i])]));
    } else {
      for (const s of active) {
        const d = curve(s.id);
        ctx.strokeStyle = colourOf(s);
        strokeSpline(ctx, GRID.map((f, i) => [X(f), Y(d[i])]));
      }
    }

    if (live && hoverX != null && hoverX >= L && hoverX <= L + pw) {
      ctx.strokeStyle = TOK.axis; ctx.globalAlpha = .45; ctx.lineWidth = 1;
      ctx.beginPath(); ctx.moveTo(hoverX + 0.5, T); ctx.lineTo(hoverX + 0.5, T + ph); ctx.stroke(); ctx.globalAlpha = 1;
      const hz = F0 * Math.pow(F1 / F0, (hoverX - L) / pw);
      const dot = (y, c) => { ctx.beginPath(); ctx.arc(hoverX, y, 3.5, 0, 7); ctx.fillStyle = c; ctx.fill(); ctx.lineWidth = 2; ctx.strokeStyle = TOK.bg; ctx.stroke(); };
      if (diff) dot(Y(dbAt(sel[1].id, hz) - dbAt(sel[0].id, hz)), SERIES[0]);
      else for (const s of active) dot(Y(dbAt(s.id, hz)), colourOf(s));
    }
    ctx.restore();
    return { L, T, pw, ph };
  }

  function onMove(e) {
    if (!plot || !sel.length) return;
    const r = cv.getBoundingClientRect();
    const x = e.clientX - r.left, y = e.clientY - r.top;
    const { L, T, pw, ph } = plot;
    if (x < L || x > L + pw || y < T || y > T + ph) { hoverX = null; tip.style.opacity = '0'; draw(); return; }
    hoverX = x;
    const hz = F0 * Math.pow(F1 / F0, (x - L) / pw);
    const diff = mode === 'difference' && sel.length >= 2;
    let html = `<div class="th">${hz >= 1000 ? (hz / 1000).toFixed(2) + ' kHz' : Math.round(hz) + ' Hz'}</div>`;
    if (diff) {
      const v = dbAt(sel[1].id, hz) - dbAt(sel[0].id, hz);
      html += `<div class="tr"><i style="background:${SERIES[0]}"></i>correction<b>${v >= 0 ? '+' : ''}${v.toFixed(1)} dB</b></div>`;
    } else {
      const sd = sdAt(hz);
      for (const s of sel) html += `<div class="tr"><i style="background:${colourOf(s)}"></i>${label(s.id)}<b>${dbAt(s.id, hz).toFixed(1)} dB</b></div>`;
      html += `<div class="tr" style="color:var(--muted-2);font-size:10px;margin-top:3px">${sd == null ? '± not characterized' : '±' + sd.toFixed(2) + ' dB seating'}</div>`;
    }
    tip.innerHTML = html;
    tip.style.opacity = '1';
    const tw = tip.offsetWidth, th = tip.offsetHeight;
    tip.style.left = Math.min(x + 16, L + pw - tw) + 'px';
    tip.style.top = Math.max(T, Math.min(y - th / 2, T + ph - th)) + 'px';
    draw();
  }

  function setMode(m) {
    mode = m;
    $('m-ov').classList.toggle('on', m === 'overlay');
    $('m-df').classList.toggle('on', m === 'difference');
    $('band-t').style.opacity = m === 'difference' ? '0.4' : '1';
    $('band').disabled = m === 'difference';
    renderLegend(); renderCaption(); draw(); syncUrl();
  }

  $('m-ov').addEventListener('click', () => setMode('overlay'));
  $('m-df').addEventListener('click', () => setMode('difference'));
  $('band').addEventListener('change', (e) => {
    showBand = e.target.checked;
    $('band-t').classList.toggle('on', showBand);
    renderLegend(); renderCaption(); draw(); syncUrl();
  });
  $('src-archive').addEventListener('change', (e) => {
    const on = e.target.checked;
    e.target.closest('.src').classList.toggle('on', on);
    loadSource(on ? 'archive' : 'ours');
    renderList(); renderLegend(); renderCaption(); draw(); syncUrl();
  });
  $('target').addEventListener('change', (e) => {
    targetId = e.target.value;
    renderLegend(); renderCaption(); draw(); syncUrl();
  });
  $('yscale').addEventListener('change', (e) => {
    yScale = e.target.value === 'auto' ? 'auto' : Number(e.target.value);
    draw(); syncUrl();
  });
  $('smooth').addEventListener('change', (e) => {
    smoothOct = Number(e.target.value);
    resmoothAll();
    // the target is cached under its own key and must be rebuilt at the new smoothing too
    for (const k of [...DB.keys()].filter((k) => k.startsWith('__target__'))) { DB.delete(k); SMOOTH.delete(k); }
    renderLegend(); renderCaption(); draw(); syncUrl();
  });
  $('align').addEventListener('change', (e) => {
    alignMode = e.target.value;
    alignCache.clear();
    renderLegend(); renderCaption(); draw(); syncUrl();
  });
  $('copy-link').addEventListener('click', (e) => copyLink(e.currentTarget));
  $('save-png').addEventListener('click', exportPng);
  $('q').addEventListener('input', renderList);
  cv.addEventListener('mousemove', onMove);
  cv.addEventListener('mouseleave', () => { hoverX = null; tip.style.opacity = '0'; draw(); });

  // Touch: a phone has no hover, so without this the readout — the whole reason to point at a
  // curve — is simply unavailable on the device most likely to open a shared link. Drag along the
  // plot scrubs the crosshair. preventDefault only while the touch is inside the plot, so the page
  // still scrolls normally when the gesture starts anywhere else.
  const touchAt = (e) => {
    const t = e.touches[0];
    if (!t) return;
    onMove({ clientX: t.clientX, clientY: t.clientY });
  };
  cv.addEventListener('touchstart', (e) => {
    if (!plot || !sel.length) return;
    const r = cv.getBoundingClientRect(), t = e.touches[0];
    const x = t.clientX - r.left, y = t.clientY - r.top;
    if (x < plot.L || x > plot.L + plot.pw || y < plot.T || y > plot.T + plot.ph) return;
    e.preventDefault();
    touchAt(e);
  }, { passive: false });
  cv.addEventListener('touchmove', (e) => {
    if (hoverX == null) return;   // only scrub if the gesture began on the plot
    e.preventDefault();
    touchAt(e);
  }, { passive: false });
  cv.addEventListener('touchend', () => { hoverX = null; tip.style.opacity = '0'; draw(); });
  new ResizeObserver(() => draw()).observe(cv.parentElement);
  document.querySelector('.method').addEventListener('toggle', () => requestAnimationFrame(draw));

  // A canvas doesn't notice a CSS variable change, so the theme toggle has to tell it. Re-read the
  // tokens (the series palette differs between light and dark for contrast) and repaint everything
  // that carries colour — swatches and legend included, not just the plot.
  function onThemeChange() {
    TOK = WLPlot.readTokens();
    SERIES = TOK.series;
    renderList(); renderLegend(); renderCaption(); draw();
  }
  window.addEventListener('wl-theme-change', onThemeChange);

  boot(PAYLOAD);
</script>
