---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
import { FORMSPREE } from '../data/config.js';
import { WANTED } from '../data/wanted.js';

const SITE = 'https://warrenlabs.com';
const url = `${SITE}/measure`;
const title = 'Send us your headphones to measure';
const description =
  'Mail in your headphones and we measure them on our rig, seated for best fit, published as one real seating. You get your unit’s exact curve back, and the model gets a credited page here. Insured both ways, back in about a week.';

// Dedicated intake endpoint (see src/data/config.js). Empty is safe: the form validates and shows a
// friendly confirmation instead of POSTing nowhere, so the page ships before the Formspree form exists.
const endpoint = FORMSPREE.measure ?? '';

// One source for the visible FAQ and the FAQPage schema so they can never drift.
const faq: [string, string][] = [
  [
    'Does it cost me anything?',
    'It depends which lane you are in. If the model is on the requested list we cover shipping both ways, inbound and back. If you are sending a unit we have not asked for, the $89 covers the measurement and you cover shipping.',
  ],
  [
    'Is my headphone insured in transit?',
    'Yes, both directions. You tell us the value, we insure to it, and we photograph the unit on arrival and again before it ships back. Documented, not a gotcha.',
  ],
  [
    'How long will you keep it?',
    'We measure and ship it back within about five business days of arrival. If anything will take longer, we tell you before you send it.',
  ],
  [
    'What if the measurement is unflattering?',
    'We publish it anyway. Honest graphs are the whole point. We show exactly how a headphone measures, good or bad. What we will not do is dress it up.',
  ],
  [
    'What if you can’t publish mine?',
    'Sometimes a unit arrives damaged, won’t seal on the rig, or gives data we don’t trust. If that happens we tell you why, you still get your unit’s curve, and we simply don’t publish it.',
  ],
  [
    'Do I need an account?',
    'No. There is no account, no profile and no sign-up. Tell us on the intake form how you want to be credited, and that is all we need.',
  ],
  [
    'What headphones can you measure?',
    'Over-ear and on-ear headphones. Not IEMs. An in-ear’s response is decided by how deep it sits and how well the tip seals, and our fixture is an artificial ear with no way to control either. Measuring them here would produce a confident-looking number we could not stand behind, so we don’t. If you’re not sure yours qualifies, tell us in the form and we’ll say.',
  ],
  [
    'Do you have old measurements from HeadRoom?',
    'We hold them: 319 headphones measured on a Head Acoustics HMS II.3 around 2010–2013, but we no longer publish them as measurements, and we don’t mix them with anything measured here. They are one unit per model, on a head that no longer exists, with no record of how the headphone was seated. We keep them as a research reference and measure from scratch instead. Your headphone gets measured on our own bench and labeled as such.',
  ],
];

const jsonLd = [
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(([q, a]) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/` },
      { '@type': 'ListItem', position: 2, name: 'Measure', item: url },
    ],
  },
];

const steps: [string, string][] = [
  ['Tell us what you’ve got', 'Fill in the form below: make, model, and how to reach you. Takes a minute.'],
  ['We send a label', 'You get a prepaid, insured return label, our address, and simple packing notes by email.'],
  ['You ship it', 'Box it up and send it. It’s insured to the value you declare, door to door.'],
  ['We measure & publish', 'It goes on the rig, gets an honest page of its own, and heads back to you in about a week.'],
  ['You get your curve', 'Your unit’s exact measurement lands in your inbox, credited however you asked.'],
];
---

<Layout title={`${title} · Warren Labs`} description={description} jsonLd={jsonLd}>
  <Nav variant="home" />

  <!-- ---------- hero ---------- -->
  <section class="sec hero">
    <div class="wrap">
      <span class="eyebrow">The bench &middot; Send one in</span>
      <h1>Send us your headphones.<br />We&rsquo;ll measure them.</h1>
      <p class="lede">
        Every correction you can buy is built from somebody else&rsquo;s sample of your model. This is the
        one way to get the curve of the pair actually in your hands. Your unit&rsquo;s
        <em>exact</em> measurement comes back by email, and if that model has no page here yet,
        it gets one. Two ways in: if it is a model we are asking for, it is free and we cover shipping
        both ways. Any other headphone you own is $89, and you cover the postage.
      </p>
      <div class="cta-row">
        <Button href="#intake" variant="primary" size="lg">Send one in</Button>
        <Button href="#how" variant="ghost" size="lg">How it works</Button>
      </div>
      <p class="hero-fine">
        Measured on a miniDSP&nbsp;EARS&nbsp;Pro, labelled by rig, and published either way, flattering or not. About a week on the bench.
      </p>
    </div>
  </section>

  <!-- ---------- what you get ---------- -->
  <section class="sec band">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">What you get</span>
        <h2>What you get back.</h2>
      </div>
      <div class="grid4">
        <div class="card">
          <h3>Your unit&rsquo;s exact curve</h3>
          <p>
            Not &ldquo;the&rdquo; HD&nbsp;650, <b>yours</b>. Unit variation is real, and knowing how
            your specific pair measures is exactly what <a href="/attune">Attune</a> turns into a personal
            tuning.
          </p>
        </div>
        <div class="card">
          <h3>Free if we are asking for it</h3>
          <p>
            We keep a public list of the models we most want on the bench. If yours is on it, the
            measurement is free and we pay shipping both ways. Anything else you own is <b>$89</b>,
            and you cover the postage.
          </p>
        </div>
        <div class="card">
          <h3>Your name on the page</h3>
          <p>
            Published measurements carry a <b>credit line</b>, named however you want: your name, a
            handle, or not at all. Just tell us which.
          </p>
        </div>
        <div class="card">
          <h3>Every result gets published</h3>
          <p>
            We publish what the rig says, flattering or not. A headphone that measures badly is as
            useful to the next person as one that measures well, and an archive that quietly drops
            the bad ones is worth nothing.
          </p>
        </div>
      </div>
      <p class="rig-note">
        <b>How this stays honest.</b> Paid work and published measurements are kept apart. Buying a
        design review or a production measurement does not affect whether a product gets
        measured here, what the result says, or whether it goes up. Every measurement page
        states whether the maker has ever paid Warren Labs for anything, including when the
        answer is no.
      </p>
    </div>
  </section>

  <!-- ---------- how it works ---------- -->
  <section id="how" class="sec band">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">How it works</span>
        <h2>Five steps, most of them ours.</h2>
        <p class="sec-lede">
          Your part is a minute of typing and a trip to the drop-off. We handle the label, the insurance,
          the measurement, and the return.
        </p>
      </div>
      <ol class="steps">
        {
          steps.map(([h, p], i) => (
            <li>
              <span class="step-n">{i + 1}</span>
              <div>
                <h3>{h}</h3>
                <p>{p}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ---------- trust ---------- -->
  <section class="sec band">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">The fine print, up front</span>
        <h2>Your headphone, handled with care.</h2>
      </div>
      <div class="grid3">
        <div class="trust-item">
          <div class="trust-k">Insured both ways</div>
          <p>You declare the value; we insure to it, inbound and outbound. We photograph condition on arrival and before return.</p>
        </div>
        <div class="trust-item">
          <div class="trust-k">Back in about a week</div>
          <p>Measured and shipped home within about five business days of arrival. If anything will run long, you hear it first.</p>
        </div>
        <div class="trust-item">
          <div class="trust-k">Honest, or not at all</div>
          <p>We publish exactly what we measure. If we can&rsquo;t trust the data or the unit arrives damaged, we tell you why and don&rsquo;t publish. You still get your curve.</p>
        </div>
      </div>
      <p class="rig-note">
        <b>A word on the rig.</b> Your headphone is measured on our own bench (a miniDSP&nbsp;EARS&nbsp;Pro),
        seated deliberately for the best fit and labeled that way. What we publish is one real seating,
        never a blend of several. One unit is one unit, not the whole model, which is exactly why
        measuring <em>your</em> pair is worth doing.
        <a href="/learn/how-to-read-a-frequency-response-graph">How to read the graph &rarr;</a>
      </p>
    </div>
  </section>

  <!-- ---------- intake form ---------- -->

  <!-- ---------- the requested list ---------- -->
  <section id="wanted" class="sec band">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">The list</span>
        <h2>What we&rsquo;re asking for.</h2>
        <p class="sec-lede">
          We are building this corpus from scratch, one headphone at a time. These are the models we most
          want on the bench first, and the reason each one earns a slot. Send one of these and the
          measurement is free, with shipping covered both ways. Anything else you own is $89.
        </p>
      </div>
      <div class="wantgrid">
        {WANTED.map((b) => (
          <div class="wantcol">
            <h3>{b.name}</h3>
            <ul>
              {b.items.map((it) => (
                <li>
                  <span class="wn">{it.name}</span>
                  <span class={'wp ' + it.pri.toLowerCase()}>{it.pri}</span>
                  <span class="ww">{it.why}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <p class="wantfoot">
        P1 is what we want first. P2 is the second wave. P3 fills a real gap when one turns up. Not on
        the list and still want yours measured? That is the $89 lane, and the answer is yes.
      </p>
    </div>
  </section>

  <section id="intake" class="sec band">
    <div class="wrap intake-wrap">
      <div class="sec-head center">
        <span class="eyebrow center">Start here</span>
        <h2>Send one in.</h2>
        <p class="sec-lede">
          Tell us what you&rsquo;ve got and how to reach you. We&rsquo;ll email a prepaid, insured label
          and where to send it. No charge, no card.
        </p>
      </div>

      <form id="intake-form" class="intake" data-endpoint={endpoint} novalidate>
        <input type="hidden" name="interest" value="measurement" />
        <input type="hidden" name="_subject" value="New Warren Labs measurement intake" />
        <input type="text" name="_gotcha" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <div class="f2">
          <label class="field">
            <span>You are</span>
            <select name="role">
              <option value="individual">An owner sending one in</option>
              <option value="brand">A brand or retailer</option>
            </select>
          </label>
          <label class="field">
            <span>Type</span>
            <select name="type">
              <option value="over-ear">Over-ear</option>
              <option value="on-ear">On-ear</option>
              <option value="mixed">A few, mixed</option>
            </select>
          </label>
        </div>

        <label class="field">
          <span>Headphone make &amp; model<b class="req" aria-hidden="true">*</b></span>
          <input type="text" name="headphones" required placeholder="e.g. Sennheiser HD 650" />
        </label>

        <div class="f2">
          <label class="field">
            <span>Your name<b class="req" aria-hidden="true">*</b></span>
            <input type="text" name="name" required autocomplete="name" placeholder="First and last" />
          </label>
          <label class="field">
            <span>Email<b class="req" aria-hidden="true">*</b></span>
            <input type="email" name="email" required autocomplete="email" placeholder="you@example.com" />
          </label>
        </div>

        <div class="f2">
          <label class="field">
            <span>City / country <i>(for shipping)</i></span>
            <input type="text" name="location" autocomplete="address-level2" placeholder="e.g. Bozeman, US" />
          </label>
          <label class="field">
            <span>Credit as <i>(name, handle, or leave blank)</i></span>
            <input type="text" name="handle" placeholder="optional" />
          </label>
        </div>

        <label class="field">
          <span>Anything else</span>
          <textarea name="notes" rows="3" placeholder="Condition, whether you’d rather stay anonymous, questions, anything."></textarea>
        </label>

        <button type="submit" class="btn btn-primary btn-lg intake-submit">Send my details</button>
        <p class="intake-fine">We only use this to arrange the measurement. No spam, no list-selling.</p>
        <p class="intake-note" data-note hidden></p>
      </form>
    </div>
  </section>

  <!-- ---------- vendors ---------- -->
  <section class="sec band">
    <div class="wrap">
      <div class="vendor">
        <div>
          <span class="eyebrow">Brands &amp; retailers</span>
          <h2 class="vendor-h">Have a lineup? Let&rsquo;s measure it.</h2>
          <p>
            A loaner gets your headphone an honest measurement and a <b>permanent page built to rank</b> for
            &ldquo;model frequency response&rdquo;: a durable marketing asset, not a one-off review.
            We cover shipping both ways, insure it in transit, and send it back the day the page goes up.
            Pick <em>&ldquo;A brand or retailer&rdquo;</em> in the form and we&rsquo;ll take it from there.
          </p>
          <Button href="#intake" variant="ghost">Arrange a loaner</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- ---------- faq ---------- -->
  <section class="sec band">
    <div class="wrap faq-wrap">
      <div class="sec-head">
        <span class="eyebrow">Questions</span>
        <h2>The obvious ones.</h2>
      </div>
      <div class="faq">
        {
          faq.map(([q, a]) => (
            <div class="faq-item">
              <h3>{q}</h3>
              <p>{a}</p>
            </div>
          ))
        }
      </div>

      <div class="related">
        <a href="/collections/headphones">Browse the measurements &rarr;</a>
        <a href="/attune">What Attune does &rarr;</a>
        <a href="/learn">Learn the basics &rarr;</a>
      </div>
    </div>
  </section>

  <Footer variant="home" />
</Layout>

<script>
  const form = document.getElementById('intake-form');
  if (form instanceof HTMLFormElement) {
    const endpoint = form.getAttribute('data-endpoint') || '';
    const submit = form.querySelector('.intake-submit') as HTMLButtonElement | null;
    const note = form.querySelector('[data-note]') as HTMLElement | null;

    const setNote = (msg: string, kind: string) => {
      if (!note) return;
      note.textContent = msg;
      note.hidden = !msg;
      note.dataset.kind = kind;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      if (data.get('_gotcha')) return; // bot
      const name = String(data.get('name') || '').trim();
      const email = String(data.get('email') || '').trim();
      const headphones = String(data.get('headphones') || '').trim();
      if (!headphones || !name) {
        setNote('Please add your name and the headphone make & model.', 'err');
        return;
      }
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        setNote('Please enter a valid email so we can send the label.', 'err');
        return;
      }
      // No endpoint wired yet: succeed gracefully so the page is safe to ship early.
      if (!endpoint) {
        form.querySelectorAll('input, select, textarea, .intake-submit').forEach((el) => {
          (el as HTMLInputElement).disabled = true;
        });
        setNote('Got it, you’re in. We’ll be in touch to arrange the label and shipping.', 'ok');
        return;
      }
      if (submit) submit.disabled = true;
      setNote('Sending…', '');
      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: data,
        });
        if (res.ok) {
          form.querySelectorAll('input, select, textarea, .intake-submit').forEach((el) => {
            (el as HTMLInputElement).disabled = true;
          });
          setNote('Got it, you’re in. We’ll email you the label and where to send it.', 'ok');
        } else {
          setNote('Something went wrong. Please try again in a moment.', 'err');
          if (submit) submit.disabled = false;
        }
      } catch {
        setNote('Network error. Please try again in a moment.', 'err');
        if (submit) submit.disabled = false;
      }
    });
  }
</script>

<style>
  /* the requested list */
  .wantgrid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 26px 34px;
  }
  .wantcol h3 {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    border-bottom: 1px solid var(--line);
    padding-bottom: 8px;
    margin-bottom: 12px;
  }
  .wantcol ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; }
  .wantcol li { display: grid; grid-template-columns: 1fr auto; gap: 2px 10px; }
  .wn { font-size: 14.5px; color: var(--text); font-weight: 500; }
  .wp {
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.1em;
    color: var(--muted-2);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 1px 5px;
    align-self: start;
  }
  .wp.p1 { color: var(--accent); border-color: color-mix(in oklab, var(--accent) 40%, var(--line)); }
  .ww { grid-column: 1 / -1; font-size: 12.5px; line-height: 1.5; color: var(--muted-2); }
  .wantfoot { margin-top: 28px; font-size: 13.5px; color: var(--muted); max-width: 62ch; }

  /* hero */
  .hero {
    padding-top: 72px;
    padding-bottom: 56px;
  }
  .hero h1 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(38px, 6vw, 68px);
    line-height: 1.02;
    letter-spacing: -0.01em;
    margin: 16px 0 0;
  }
  .lede {
    color: var(--muted);
    font-size: clamp(17px, 2vw, 20px);
    line-height: 1.62;
    max-width: 60ch;
    margin: 20px 0 0;
  }
  .lede em {
    color: var(--text);
    font-style: italic;
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin: 30px 0 0;
  }
  .hero-fine {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.03em;
    color: var(--muted-2);
    margin: 22px 0 0;
  }

  /* card grids */
  .grid4,
  .grid3 {
    display: grid;
    gap: 18px;
    margin-top: 40px;
  }
  .grid4 {
    grid-template-columns: repeat(4, 1fr);
  }
  .grid3 {
    grid-template-columns: repeat(3, 1fr);
  }
  .card a {
    color: var(--accent-soft);
  }
  .card a:hover {
    color: var(--accent);
  }

  /* steps */
  .steps {
    list-style: none;
    counter-reset: none;
    margin: 40px 0 0;
    padding: 0;
    display: grid;
    gap: 2px;
  }
  .steps li {
    display: flex;
    gap: 20px;
    align-items: flex-start;
    padding: 22px 0;
    border-top: 1px solid var(--line-soft);
  }
  .steps li:first-child {
    border-top: none;
  }
  .step-n {
    flex: none;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid var(--accent-line);
    background: var(--accent-dim);
    color: var(--accent-soft);
    font-family: var(--mono);
    font-size: 15px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .steps h3 {
    font-size: 18px;
    font-weight: 600;
    margin: 6px 0 0;
    color: var(--text);
  }
  .steps p {
    color: var(--muted);
    font-size: 15.5px;
    line-height: 1.6;
    margin: 6px 0 0;
    max-width: 60ch;
  }

  /* trust */
  .trust-item {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 24px 24px;
  }
  .trust-k {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent-soft);
    margin-bottom: 10px;
  }
  .trust-item p {
    color: var(--muted);
    font-size: 15px;
    line-height: 1.6;
    margin: 0;
  }
  .rig-note {
    margin: 26px 0 0;
    padding: 22px 24px;
    border: 1px solid var(--line);
    border-left: 2px solid var(--accent);
    border-radius: var(--radius);
    background: var(--bg-deep);
    color: var(--muted);
    font-size: 15.5px;
    line-height: 1.65;
  }
  .rig-note b {
    color: var(--text);
  }
  .rig-note a {
    color: var(--accent-soft);
    white-space: nowrap;
  }
  .rig-note a:hover {
    color: var(--accent);
  }

  /* intake form */
  .intake-wrap {
    max-width: 720px;
  }
  .intake {
    margin-top: 34px;
    background: linear-gradient(180deg, var(--surface), var(--bg-deep));
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 30px 28px 26px;
  }
  .f2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .field {
    display: block;
    margin-bottom: 16px;
  }
  .field > span {
    display: block;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 7px;
  }
  .field > span i {
    font-style: normal;
    text-transform: none;
    letter-spacing: 0;
    color: var(--muted-2);
  }
  .field .req {
    color: var(--accent);
    margin-left: 3px;
  }
  .field input,
  .field select,
  .field textarea {
    width: 100%;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 9px;
    color: var(--text);
    font-family: var(--sans);
    font-size: 14.5px;
    padding: 12px 13px;
    outline: none;
    transition:
      border-color 0.15s,
      box-shadow 0.15s;
  }
  .field textarea {
    resize: vertical;
    min-height: 80px;
  }
  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    border-color: var(--accent-line);
    box-shadow: 0 0 0 3px var(--accent-dim);
  }
  .intake-submit {
    width: 100%;
    margin-top: 4px;
  }
  .intake-fine {
    text-align: center;
    font-size: 11.5px;
    color: var(--muted-2);
    font-family: var(--mono);
    letter-spacing: 0.02em;
    margin: 12px 0 0;
  }
  .intake-note {
    margin: 14px 0 0;
