  /* ---------- Attune lock-up ----------
     ONE MARK PER LOCK-UP. The Attune mark was briefed as a sibling to the Warren Labs W — one
     continuous stroke, rounded caps, drawn not constructed — so the two compete rather than nest
     when they share a signature. Attune is the speaker on this page, so its mark leads and Warren
     Labs is a text credit. The W is not gone from the site; it still leads in the header, the
     footer and every page where the lab speaks. It just does not appear inside this lock-up.

     Proportions are the exported vertical lock-up's, driven off --wm so the three parts can only
     scale together: mark ink 0.63x the wordmark, credit 0.24x (11/46 in the export).
     tools/make_lockup.py in the Attune repo is the source of those numbers. */
  .brand-lockup {
    --wm: 46px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: fit-content;
    margin-bottom: 22px;
  }
  /* AMBER IS GROUND-DEPENDENT, and this is measured, not taste. #FF9E2C — the site accent — is
     1.87:1 on a light ground, so a token-coloured mark all but vanishes at small sizes. These are
     Attune's own two ambers, and they are deliberately literal rather than var(--accent): the mark
     is a locked asset and must not drift if the site accent is retuned.
       #EE9A3A on #0c0d0f  8.6:1     #A8641E on #f7f8f9  4.4:1 */
  .a-mark {
    color: #ee9a3a;
    height: calc(var(--wm) * 0.63);
    width: auto;
    display: block;
    /* Tuned by measuring the rendered gap (mark ink bottom -> wordmark baseline = 1.415x --wm in
       the export) rather than by eye, because the wordmark's line box is not its cap height. */
    margin-bottom: calc(var(--wm) * 0.632);
  }
  :root[data-theme='light'] .a-mark {
    color: #a8641e;
  }
  .wordmark {
    font-family: 'Instrument Serif', Georgia, 'Times New Roman', serif;
    font-size: var(--wm);
    line-height: 0.9;
    /* 0.012em, NOT 0.3px. 0.3px is the app header's tracking at its 25px wordmark; hard-coding it
       here left the type fractionally tighter than the export at 46px and would drift further at
       any other size. In em it scales with --wm, which is the whole point of the rule that the
       lock-up's parts only ever move together. */
    letter-spacing: 0.012em;
    color: var(--text);
  }
  /* A third of the title at most, or it stops reading as a credit and starts competing. */
  .by {
    /* wordmark baseline -> credit baseline = 0.457x --wm in the export. */
    margin-top: calc(var(--wm) * 0.133);
    font-family: var(--mono);
    font-size: calc(var(--wm) * 0.24);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    line-height: 1;
    color: var(--muted);
  }
  @media (max-width: 720px) {
    .brand-lockup { --wm: 36px; margin-bottom: 18px; }
  }

