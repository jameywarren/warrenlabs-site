---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
import AttuneCockpitDemo from '../components/AttuneCockpitDemo.astro';
import AttuneEarExamDemo from '../components/AttuneEarExamDemo.astro';
import AttuneVoiceMatchDemo from '../components/AttuneVoiceMatchDemo.astro';

// Attune shipped on the Mac App Store 2026-08-12. The beta DMG is retired: a side-loaded copy gets no
// updates and cannot buy Pro, so every download path now points at the store listing.
const APP_STORE = 'https://apps.apple.com/app/attune-headphone-eq/id6792873303';

const attuneApp = {
  '@type': 'SoftwareApplication',
  name: 'Attune',
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'macOS',
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'USD',
    lowPrice: '0',
    highPrice: '39',
    offerCount: 2,
  },
  description:
    'Personal-EQ and real-time A/B auditioning for macOS. Tune any headphone to your taste: blind, loudness-matched, on your own music.',
  brand: { '@type': 'Brand', name: 'Warren Labs' },
  publisher: { '@id': 'https://warrenlabs.com/#organization' },
  // Attune's own mark, not the lab's. The Organization node in Layout.astro still points at the W.
  image: 'https://warrenlabs.com/assets/attune/og-attune.png',
  logo: 'https://warrenlabs.com/assets/attune/attune-appicon.svg',
};
---

<Layout
  title="Attune · Find your sound"
  description="Attune is a Warren Labs product: personal-EQ and real-time A/B auditioning for macOS. Tune any headphone to your taste, blind and loudness-matched, on your own music. Free on the Mac App Store."
  signup="attune"
  jsonLd={attuneApp}
  wordmark
  favicon="attune"
  image="/assets/attune/og-attune.png"
>
  <Nav variant="attune" />

  <!-- ===================== HERO ===================== -->
  <header class="hero">
    <div class="wrap hero-grid">
      <div>
        {/* The Attune vertical lock-up, live rather than the exported SVG: the page loads the same
            woff2 the export is cut from, so the type matches, and live text stays selectable,
            theme-aware and crisp at any size. The mark path is copied verbatim from the export —
            never redraw it. See Assets/Logo/export/README.md in the Attune repo. */}
        <span class="brand-lockup">
          <svg class="a-mark" viewBox="10.5 23.5 79 48" fill="none" stroke="currentColor" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 68 H26 C36 68 40 27 50 27 C60 27 64 68 74 68 H86"/></svg>
          <span class="wordmark">Attune</span>
          <span class="by">by Warren Labs</span>
        </span>
        <span class="eyebrow">Free &middot; on the Mac App Store</span>
        <h1>Find <em>your</em> sound.</h1>
        <p class="lede">
          Hear your headphones the way <b style="color:var(--text)">you</b> want, or voiced like another headphone
          entirely. Then actually listen and choose. The audition is <b
            style="color:var(--text)">free</b>, no subscription.
        </p>
        <div class="hero-cta">
          <Button href={APP_STORE} variant="primary" size="lg">Download on the Mac App Store</Button>
          <Button href="#how" variant="ghost" size="lg">See how it works</Button>
        </div>
        <div class="hero-note"><span class="dot"></span> Free &middot; macOS 12 or later &middot; Apple&nbsp;Silicon</div>

        {/* Handoff from /graphs Difference mode. Someone who arrives here has already picked a pair
            and been told what the correction looks like — landing them on a generic hero throws that
            away. Filled client-side from ?yours=&target= and left hidden otherwise; the names are
            resolved against the corpus, never echoed from the URL (that would be an injection). */}
        <p class="handoff" id="handoff" hidden></p>
      </div>

      <AttuneCockpitDemo />
    </div>
  </header>

  <!-- ===================== PROBLEM ===================== -->
  <section id="problem" class="band">
    <div class="wrap sec">
      <div class="sec-head">
        <span class="eyebrow">The problem</span>
        <h2>A graph is a line. Listening is personal.</h2>
        <p class="sec-lede">
          Measurement sites can tell you what your headphones do. None can tell you what they do
          <em style="color:var(--text);font-style:normal">for you</em>, and none let you actually hear the difference.
        </p>
      </div>

      <div class="prob-grid">
        <div class="card">
          <div class="n">01</div>
          <h3>Numbers aren't a sound</h3>
          <p>A frequency-response curve is a chart to read, not a thing to hear. Two people looking at the same line want two different tunings, and neither can tell from the graph.</p>
        </div>
        <div class="card">
          <div class="n">02</div>
          <h3>One "correct" target</h3>
          <p>Diffuse-field. Neutral. Somebody's house curve. Every tool hands you one preset curve and calls it right. Your gear and your taste never got a vote.</p>
        </div>
        <div class="card">
          <div class="n">03</div>
          <h3>Nowhere to actually listen</h3>
          <p>Most tools stop at data and presets. The one thing that matters, <em style="color:var(--text);font-style:normal">hearing it on your music and choosing</em>, is left to you.</p>
        </div>
      </div>

      <div class="pull">The best tuning for your headphones isn't the "right" one.<br /><span>It's the one you'd pick with your eyes closed.</span></div>
    </div>
  </section>

  <!-- ===================== HOW IT WORKS ===================== -->
  <section id="how" class="band">
    <div class="wrap sec">
      <div class="sec-head">
        <span class="eyebrow">How it works</span>
        <h2>Four steps to your sound. Under a minute.</h2>
        <p class="sec-lede">The graph becomes the surface you're hearing through, not a chart you're reading. Everything runs in real time on your own music.</p>
      </div>

      <div class="steps">
        <!-- 1 -->
        <div class="step">
          <div class="k">STEP 01</div>
          <div class="ic">
            <svg width="34" height="34" viewBox="0 0 34 34" fill="none">
              <path d="M6 22c0-7 5-12 11-12s11 5 11 12" stroke="#FF9E2C" stroke-width="1.7" stroke-linecap="round"></path>
              <rect x="4" y="20" width="5" height="9" rx="2.5" stroke="#e8ebed" stroke-width="1.6"></rect>
              <rect x="25" y="20" width="5" height="9" rx="2.5" stroke="#e8ebed" stroke-width="1.6"></rect>
            </svg>
          </div>
          <h3>Pick your headphone</h3>
          <p>Search a curated library of popular wired cans &amp; IEMs, or import your own measurement (CSV, AutoEQ, squig), free.</p>
          <svg class="arrow" width="18" height="18" viewBox="0 0 18 18"><path d="M6 4l5 5-5 5" stroke="#5f646b" stroke-width="1.5" fill="none" stroke-linecap="round"></path></svg>
        </div>
        <!-- 2 -->
        <div class="step">
          <div class="k">STEP 02</div>
          <div class="ic">
            <svg width="34" height="34" viewBox="0 0 34 34" fill="none">
              <text x="4" y="22" font-family="ui-monospace,monospace" font-size="15" fill="#FF9E2C" font-weight="600">A</text>
              <path d="M17 9v16" stroke="#22252a" stroke-width="1.4"></path>
              <text x="21" y="22" font-family="ui-monospace,monospace" font-size="15" fill="#e8ebed" font-weight="600">B</text>
            </svg>
          </div>
          <h3>Audition A / B</h3>
          <p>A blind, loudness-matched face-off plays on the track you're already hearing. Just tap the one you like. <b style="color:var(--text)">A or B?</b></p>
          <svg class="arrow" width="18" height="18" viewBox="0 0 18 18"><path d="M6 4l5 5-5 5" stroke="#5f646b" stroke-width="1.5" fill="none" stroke-linecap="round"></path></svg>
        </div>
        <!-- 3 -->
        <div class="step">
          <div class="k">STEP 03</div>
          <div class="ic">
            <svg width="46" height="34" viewBox="0 0 46 34" fill="none">
              <path d="M2 24C8 24 8 12 14 12s6 14 12 14 6-18 18-8" stroke="#e8ebed" stroke-width="1.8" stroke-linecap="round"></path>
              <circle cx="26" cy="26" r="2.4" fill="#FF9E2C"></circle>
            </svg>
          </div>
          <h3>Discover your curve</h3>
          <p>Each choice nudges a personal offset. Watch <b style="color:var(--text)">your</b> curve build on the graph. Bespoke, not a canned preset.</p>
          <svg class="arrow" width="18" height="18" viewBox="0 0 18 18"><path d="M6 4l5 5-5 5" stroke="#5f646b" stroke-width="1.5" fill="none" stroke-linecap="round"></path></svg>
        </div>
        <!-- 4 -->
        <div class="step">
          <div class="k">STEP 04</div>
          <div class="ic">
            <svg width="34" height="34" viewBox="0 0 34 34" fill="none">
              <path d="M6 17l6 6 12-13" stroke="#FF9E2C" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"></path>
              <circle cx="17" cy="17" r="14" stroke="#22252a" stroke-width="1.4"></circle>
            </svg>
          </div>
          <h3>Save &amp; apply</h3>
          <p>Flip <b style="color:var(--text)">Stock&nbsp;&#8644;&nbsp;Yours</b> to hear what you gained. Save the profile per headphone, then listen for real.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== EAR-EXAM FEATURE ===================== -->
  <section class="band">
    <div class="wrap sec">
      <div class="exam">
        <div>
          <span class="eyebrow">The ear exam</span>
          <h2>Like an eye exam, for tuning.</h2>
          <p class="sec-lede">
            Six quick choices (<span class="mono">A or B?</span>) on your own music, gain-matched so loudness never
            tips your hand. No sliders, no theory. You do the deciding.
          </p>
          <ul>
            <li><span class="chk">&#9670;</span><span><b>Blind &amp; honest.</b> Every comparison is loudness-matched, so louder never masquerades as better.</span></li>
            <li><span class="chk">&#9670;</span><span><b>On your music.</b> The A/B runs on the track that's already playing, the passages you actually know.</span></li>
            <li><span class="chk">&#9670;</span><span><b>Seamless switching.</b> Crossfades between tunings instead of muting, so the only thing that changes is the sound.</span></li>
            <li><span class="chk">&#9670;</span><span><b>Yours to keep.</b> The result is a personal EQ profile, saved per headphone and portable to your other apps.</span></li>
          </ul>
        </div>

        <div class="exam-panel">
          <AttuneEarExamDemo />
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== VOICE-MATCH ===================== -->
  <section class="band">
    <div class="wrap sec">
      <div class="exam">
        <div>
          <span class="eyebrow">Voice-match</span>
          <h2>Hear another headphone&rsquo;s tuning on your own cans.</h2>
          <p class="sec-lede">
            Curious how a different headphone is voiced? <b style="color:var(--text)">Match its tonal signature</b>
            and hear how that balance would sit on the headphones already on your head: blind, loudness-matched,
            on your own music.
          </p>
          <ul>
            <li><span class="chk">&#9670;</span><span><b>Match the tonal signature,</b> not a literal clone. You borrow another tuning&rsquo;s balance (its bass, mids and treble) and hear it on your gear.</span></li>
            <li><span class="chk">&#9670;</span><span><b>Honest about the limits.</b> EQ matches tonal balance, not resolution, soundstage, distortion, or driver physics. No $80 can becomes a $4k flagship, and we won&rsquo;t pretend otherwise.</span></li>
            <li><span class="chk">&#9670;</span><span><b>A starting point, not a verdict.</b> Use a reference voicing as your baseline, then keep tuning by ear until it&rsquo;s yours.</span></li>
          </ul>
        </div>

        <div class="exam-panel">
          <AttuneVoiceMatchDemo />
          <div class="exam-cap">Matches tonal balance, not resolution, soundstage, or driver behavior.</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== CREDIBILITY ===================== -->
  <section class="band">
    <div class="wrap cred">
      <div class="cred-in">
        <div>
          <span class="eyebrow">Who's behind it</span>
          <blockquote>
            Built by people who've spent a career measuring headphones and building the tools to compare them
            honestly &mdash; side by side, level-matched, with no hype in between.
          </blockquote>
          <p class="cred-by">
            The same work continues in Attune, powered by Warren Labs' shipping <b>Level</b> correction engine: the
            loudness-matched correction DSP trusted in the studio. <b>A Warren Labs product.</b>
          </p>
        </div>
        <div class="cred-stats">
          <div class="stat"><div class="v"><span class="accent">25</span>+ yrs</div><div class="l">Professional audio &amp; headphone design</div></div>
          <div class="stat"><div class="v">1,000s</div><div class="l">Headphones measured &amp; evaluated</div></div>
          <div class="stat"><div class="v">&plusmn;<span class="accent">0.1</span> dB</div><div class="l">Loudness-matched A/B, by construction</div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== PRICING (FREE + ONE-TIME PRO) ===================== -->

  {/* Real screenshots from the shipping build, not mockups. The interactive demos above explain the
      idea better than a still can — you move a target and watch the graph follow — but only a
      screenshot proves the app exists and looks like this. Both jobs, neither compromised.
      Lazy-loaded: 5 images below the fold shouldn't cost the hero anything. */}
  <section id="shots" class="band">
    <div class="wrap">
      <span class="eyebrow">The actual app</span>
      <h2>Five screens, shot from the build.</h2>
      <p class="band-sub">
        Not renders. This is what installs.
      </p>
      <div class="shot-strip">
        <figure><img src="/assets/attune/01-cockpit.png" alt="Attune's main screen: frequency-response graph with yours, target and voice-matched curves" width="1440" height="900" loading="lazy" decoding="async" /><figcaption>The graph is the instrument.</figcaption></figure>
        <figure><img src="/assets/attune/02-another-headphone.png" alt="Voice-matching one headphone toward another" width="1440" height="900" loading="lazy" decoding="async" /><figcaption>Hear another headphone&rsquo;s voice on yours.</figcaption></figure>
        <figure><img src="/assets/attune/03-make-it-yours.png" alt="Warmth and vibrancy controls tuning the house target" width="1440" height="900" loading="lazy" decoding="async" /><figcaption>Tune the house voice to taste.</figcaption></figure>
        <figure><img src="/assets/attune/04-find-your-sound.png" alt="The blind, loudness-matched A/B listening exam" width="1440" height="900" loading="lazy" decoding="async" /><figcaption>Blind A/B, loudness-matched.</figcaption></figure>
        <figure><img src="/assets/attune/05-pro-unlock.png" alt="Saved sounds panel with the Attune Pro unlock" width="1440" height="900" loading="lazy" decoding="async" /><figcaption>Your sounds, saved.</figcaption></figure>
      </div>
    </div>
  </section>

  <section id="pricing" class="band">
    <div class="wrap sec">
      <div class="mem-head">
        <div class="sec-head">
          <span class="eyebrow">Free to find it &middot; free to keep it &middot; one-time Pro</span>
          <h2>Free to find it. Free to keep it.</h2>
          <p class="sec-lede">
            Free correction presets are everywhere, and they are good. What a preset cannot do is play you your
            own music, blind and loudness-matched, and let you pick. That part is free here, and so is <b
              style="color:var(--text)">keeping</b> what you find. Pro is a one-time unlock for people who want
            more than one profile and want to take their curve elsewhere.
          </p>
        </div>
      </div>

      <div class="incl">
        <div><span class="chk">&#9670;</span> The real-time audition engine, free forever</div>
        <div><span class="chk">&#9670;</span> One saved profile, kept, at no cost</div>
        <div><span class="chk">&#9670;</span> No account and no card to start</div>
        <div><span class="chk">&#9670;</span> No subscription. Pro is a one-time unlock.</div>
      </div>

      <div class="tiers two">
        <!-- Free -->
        <div class="tier">
          <div class="tname">Free <span class="badge">No card</span></div>
          <div class="price">$0<small></small></div>
          <div class="per">no account, no trial clock</div>
          <ul>
            <li><span class="chk">&#9670;</span> Blind, loudness-matched A/B on your own music</li>
            <li><span class="chk">&#9670;</span> The ear exam and voice match</li>
            <li><span class="chk">&#9670;</span> One saved profile, kept and reloaded every launch</li>
            <li><span class="chk">&#9670;</span> Built-in curves for popular wired cans and IEMs</li>
            <li><span class="chk">&#9670;</span> Import your own measurements (CSV, AutoEQ, squig), free, always</li>
            <li><span class="chk">&#9670;</span> The same correction engine that ships in Level</li>
          </ul>
          <Button href={APP_STORE} variant="primary">Download on the Mac App Store</Button>
          <p class="beta-req">Requires macOS 12 or later, Apple&nbsp;Silicon (M1 or later)</p>
        </div>
        <!-- Pro (one-time unlock) -->
        <div class="tier feat">
          <div class="tname">Pro <span class="badge">One-time</span></div>
          <div class="price">$39<small></small></div>
          <div class="per">paid once, never a subscription</div>
          <ul>
            <li><span class="chk">&#9670;</span> Everything in Free</li>
            <li><span class="chk">&#9670;</span> Unlimited saved profiles, across as many headphones as you own</li>
            <li><span class="chk">&#9670;</span> Export your curve and use it outside Attune: phone, DAP or dongle</li>
          </ul>
          <Button href={APP_STORE} variant="ghost">Unlock inside the app</Button>
        </div>
      </div>

      <div class="mem-foot">
        The same loudness-matched engine either way. <span class="accent">No subscription, ever.</span>{' '}
        EQ moves tonal balance and nothing else: it will not buy you resolution, soundstage, lower distortion or
        different driver physics, and nothing on this page claims otherwise.
      </div>
    </div>
  </section>

  <!-- ===================== GET STARTED CTA ===================== -->
  <section id="get" class="cta cta-section band">
    <div class="wrap">
      <span class="eyebrow" style="justify-content:center">Get started</span>
      <h2>Find your sound.</h2>
      <p>Bring your own headphones and the music you know. In under a minute you'll hear the difference. It's free on the Mac App Store.</p>
      <div class="hero-cta">
        <Button href={APP_STORE} variant="primary" size="lg">Download on the Mac App Store</Button>
      </div>
      <p class="beta-req">Requires macOS 12 or later, Apple&nbsp;Silicon (M1 or later)</p>
    </div>
  </section>

  <Footer variant="attune" />
</Layout>

<script>
  // Resolve the ids against the published corpus rather than trusting the query string. An unknown
  // id simply leaves the banner hidden, which is also what makes this safe to link to from anywhere.
  import { HEADPHONES } from '../data/headphones.js';
  const byId = Object.fromEntries(HEADPHONES.map((h) => [h.curveId ?? h.handle, h]));
  const p = new URLSearchParams(location.search);
  const y = byId[p.get('yours') || ''], t = byId[p.get('target') || ''];
  if (y && t) {
    const el = document.getElementById('handoff');
    el.textContent = `Came from the graph: Attune can voice your ${y.brand} ${y.name} toward the ${t.brand} ${t.name}, and let you A/B it, loudness-matched.`;
    el.hidden = false;
  }
</script>

<style>
  .handoff {
    margin-top: 16px; padding: 11px 14px; border-left: 2px solid var(--accent);
    background: var(--accent-dim); border-radius: 0 8px 8px 0;
    font-size: 13.5px; line-height: 1.55; color: var(--text); max-width: 54ch;
  }
  .handoff[hidden] { display: none; }

  /* ---------- hero ---------- */
  .hero {
    position: relative;
    padding: 74px 0 40px;
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: -20% -10% auto -10%;
    height: 520px;
    background: radial-gradient(60% 100% at 72% 0%, rgba(255, 158, 44, 0.1), transparent 70%);
    pointer-events: none;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.02fr 0.98fr;
    gap: 48px;
    align-items: center;
    position: relative;
  }
  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 34px;
    }
  }
  h1 {
    font-family: var(--serif);
    font-size: clamp(42px, 5.8vw, 66px);
    line-height: 1;
    letter-spacing: -0.005em;
    font-weight: 400;
    margin: 14px 0 0;
  }
  h1 em {
    font-style: normal;
    color: var(--accent);
    position: relative;
    white-space: nowrap;
  }
  .lede {
    font-size: clamp(16px, 1.9vw, 19px);
    color: var(--muted);
    max-width: 34ch;
    margin: 22px 0 0;
    line-height: 1.5;
  }
  .hero-note {
    margin-top: 20px;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--muted-2);
    display: flex;
    align-items: center;
    gap: 9px;
  }
  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 10px 1px rgba(255, 158, 44, 0.7);
  }

  /* ---------- problem ---------- */
  .prob-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 44px;
  }
  @media (max-width: 820px) {
    .prob-grid {
      grid-template-columns: 1fr;
    }
  }
  .card {
    padding: 26px 24px;
  }
  .card .n {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--accent);
    letter-spacing: 0.1em;
  }
  .card h3 {
    margin: 14px 0 8px;
  }
  .pull {
    margin-top: 52px;
    border-left: 2px solid var(--accent);
    padding: 6px 0 6px 26px;
    font-family: var(--serif);
    font-size: clamp(23px, 3.1vw, 31px);
    line-height: 1.25;
    letter-spacing: 0;
    font-weight: 400;
    max-width: 24ch;
  }
  .pull span {
    color: var(--muted-2);
  }

  /* ---------- how it works ---------- */
  .steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    margin-top: 48px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--surface);
  }
  @media (max-width: 820px) {
    .steps {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 520px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }
  .step {
    padding: 28px 24px;
    border-right: 1px solid var(--line);
    position: relative;
    min-height: 210px;
    display: flex;
    flex-direction: column;
  }
  .steps .step:last-child {
    border-right: none;
  }
  @media (max-width: 820px) {
    .step {
      border-right: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
    }
    .steps .step:nth-child(2n) {
      border-right: none;
    }
    .steps .step:nth-last-child(-n + 2) {
      border-bottom: none;
    }
  }
  @media (max-width: 520px) {
    .step {
      border-right: none !important;
      border-bottom: 1px solid var(--line) !important;
    }
    .steps .step:last-child {
      border-bottom: none !important;
    }
  }
  .step .k {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    color: var(--muted-2);
