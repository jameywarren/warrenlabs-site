---
// Interactive demo of the real Attune cockpit, adapted from attune/web/index.html's
// browser-preview mock. Pick two headphones, watch the voice-match curve build, pick a
// music loop, and flip Stock/Matched to hear the difference on real material.
//
// The CURVES are real measurements (src/data/demo-curves.js). The MUSIC is real and
// CC BY 4.0 licensed (public/audio/CREDITS.md). Only the EQ *processing* is an
// approximation of Attune's shipping engine — the badge says exactly that. Keep the
// badge honest to what each part actually is.
const uid = 'hero';
---

<div class="cockpit" data-attune-cockpit>
  <div class="cockpit-head">
    <span class="badge">Live demo &middot; real measurements, real music, approximated EQ</span>
  </div>

  <div class="at-field">
    <label class="at-lbl" for={`sel-yours-${uid}-input`}>Your headphone</label>
    <div class="at-select" id={`sel-yours-${uid}`}>
      <input id={`sel-yours-${uid}-input`} type="text" autocomplete="off" placeholder="Search headphones…" />
      <div class="at-menu"></div>
    </div>
  </div>
  <div class="at-to">↓ voice-match to ↓</div>
  <div class="at-field">
    <label class="at-lbl" for={`sel-target-${uid}-input`}>Target headphone</label>
    <div class="at-select" id={`sel-target-${uid}`}>
      <input id={`sel-target-${uid}-input`} type="text" autocomplete="off" placeholder="Search headphones…" />
      <div class="at-menu"></div>
    </div>
    <div class="at-sub-link">
      or a neutral target: <a data-neutral="Diffuse Field">Diffuse Field</a> &middot; <a data-neutral="Warren Labs">Warren Labs</a>
    </div>
  </div>

  <div class="at-gcard">
    <div class="at-ghead">
      <h3>Frequency response</h3>
      <div class="at-legend">
        <span><i style="background:var(--raw)"></i>yours</span>
        <span><i style="background:var(--accent)"></i>target</span>
        <span><i style="background:var(--text)"></i>voice-matched</span>
      </div>
    </div>
    <canvas class="at-canvas" id={`graph-${uid}`}></canvas>
    <div class="at-stats">
      <span><span class="at-stat-dot"></span>A/B match <b>±0.1 dB</b></span>
      <span id={`pair-${uid}`}>Sennheiser HD 650 → Sennheiser HD 800</span>
    </div>
  </div>

  <div class="at-transport">
    <button class="at-play" id={`play-${uid}`} aria-label="Play demo">▶</button>
    <button class="at-track at-trackbtn" id={`track-${uid}`} type="button" title="Change demo music">
      <span class="t"><span id={`track-vibe-${uid}`}>Cinematic</span> <span class="tk-swap" aria-hidden="true">⇄</span></span>
      <span class="a" id={`track-credit-${uid}`}>Aphelion · Scott Buckley · CC-BY</span>
    </button>
    <div class="at-abtoggle" id={`ab-${uid}`}>
      <button data-ab="stock" class="on">Stock</button>
      <button data-ab="matched">Matched</button>
    </div>
  </div>
</div>

<script>
  import '../scripts/attune-engine.js';

  document.querySelectorAll('[data-attune-cockpit]').forEach((root) => {
    if (root.dataset.attuneInit) return;
    root.dataset.attuneInit = '1';
    const S = window.AttuneShared;
    const uid = 'hero';
    const graph = root.querySelector(`#graph-${uid}`);
    const pairLabel = root.querySelector(`#pair-${uid}`);
    const audio = new S.WebAudioEngine();

    // Corpus slugs, not array indices. (These were '1' and '4' back when the curves were
    // synthesised from a numeric seed; with real data a stale numeric id silently falls back
    // to the default and the cockpit draws the same curve twice.)
    let sel = { yours: 'sennheiser-hd-650', target: 'sennheiser-hd-800' };
    let curves = { yours: [], target: [], matched: [] };

    function refresh() {
      const r = S.selectPair(sel.yours, sel.target);
      curves = r;
      pairLabel.textContent = r.label;
      S.sizeAndDraw(graph, () => curves);
      audio.setCurves(curves);
    }

    const yoursPicker = S.initPicker(root.querySelector(`#sel-yours-${uid}`), S.CANS, (id) => {
      sel.yours = id;
      refresh();
    });
    const targetPicker = S.initPicker(root.querySelector(`#sel-target-${uid}`), S.CANS, (id) => {
      sel.target = id;
      refresh();
    });
    yoursPicker.setValue(sel.yours);
    targetPicker.setValue(sel.target);

    root.querySelectorAll('[data-neutral]').forEach((a) => {
      a.addEventListener('click', () => {
        root.querySelector(`#sel-target-${uid} input`).value = a.dataset.neutral;
      });
    });

    const playBtn = root.querySelector(`#play-${uid}`);
    playBtn.addEventListener('click', async () => {
      await audio.toggle();
      playBtn.textContent = audio.playing ? '❚❚' : '▶';
    });

    const ab = root.querySelector(`#ab-${uid}`);
    ab.addEventListener('click', (e) => {
      const b = e.target.closest('button');
      if (!b) return;
      [...ab.children].forEach((x) => x.classList.remove('on'));
      b.classList.add('on');
      audio.setMode(b.dataset.ab);
    });

    // Demo music picker — cycles the CC-BY loops (src/scripts/attune-engine.js / CREDITS.md).
    const tracks = S.TRACKS;
    let trackIdx = 0;
    const vibeEl = root.querySelector(`#track-vibe-${uid}`);
    const creditEl = root.querySelector(`#track-credit-${uid}`);
    const showTrack = () => {
      const t = tracks[trackIdx];
      vibeEl.textContent = t.label;
      creditEl.textContent = `${t.title} · ${t.credit}`;
    };
    showTrack();
    root.querySelector(`#track-${uid}`).addEventListener('click', () => {
      trackIdx = (trackIdx + 1) % tracks.length;
      showTrack();
      audio.setTrack(tracks[trackIdx].url);
    });

    S.observeAndDraw(graph, () => curves);
    refresh();
  });
</script>

<style>
  .cockpit {
    background: linear-gradient(180deg, var(--surface) 0%, #0e1013 100%);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 18px 18px 16px;
    box-shadow:
      0 24px 60px -30px rgba(0, 0, 0, 0.9),
      0 0 0 1px rgba(255, 255, 255, 0.015) inset;
    position: relative;
  }
  .cockpit-head {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 14px;
  }
  .badge {
    font-family: var(--mono);
    font-size: 9.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted-2);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 4px 10px;
  }
</style>
