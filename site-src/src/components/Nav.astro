---
// Warren Labs header for the migrated pages.
//
// The link list comes from src/data/nav.js, which is also what tools/sync-chrome.mjs renders
// into the hand-written pages. Change the nav there, not here.
//
// Deliberately NOT sharing /css/styles.css with the hand-written site: that sheet and this
// section's global.css both define .wrap, .btn, .mono, body and a, so linking both would collide.
// These styles are scoped by Astro and are a visual match for the site header.
import { NAV, MARK_PATH, nbsp } from '../data/nav.js';

interface Props {
  variant?: 'home' | 'attune';
}
const { variant = 'home' } = Astro.props;
---

<header class="wl-head" data-variant={variant}>
  <div class="wl-head-in">
    <a class="wl-logo" href="/" aria-label="Warren Labs">
      <svg class="wl-mark" viewBox="0 0 120 80" aria-hidden="true">
        <path
          d={MARK_PATH}
          fill="none"
          stroke="currentColor"
          stroke-width="6.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
      <span>WARREN&nbsp;LABS</span>
    </a>

    <nav id="wl-nav">
      {NAV.map((l) => <a href={l.href} class={l.cta ? 'cta' : undefined} set:html={nbsp(l.label)} />)}
    </nav>

    <button class="wl-toggle" aria-label="Menu" aria-expanded="false" aria-controls="wl-nav">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<script>
  const head = document.querySelector('.wl-head');
  const toggle = document.querySelector('.wl-toggle');
  if (head && toggle) {
    const set = (open) => {
      head.classList.toggle('nav-open', open);
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    };
    toggle.addEventListener('click', () => set(!head.classList.contains('nav-open')));
    head.querySelectorAll('nav a').forEach((a) => a.addEventListener('click', () => set(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') set(false);
    });
  }
</script>

<style>
  .wl-head {
    border-bottom: 1px solid var(--line);
    position: relative;
    background: var(--bg);
  }
  .wl-head-in {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 26px 60px;
    max-width: 1320px;
    margin: 0 auto;
  }
  .wl-logo {
    display: flex;
    align-items: center;
    gap: 11px;
    color: var(--text);
    text-decoration: none;
  }
  .wl-mark {
    width: 44px;
    height: auto;
    display: block;
    overflow: visible;
    flex: none;
  }
  .wl-logo span {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 15px;
    letter-spacing: 0.22em;
  }
  nav {
    display: flex;
    gap: 32px;
    align-items: center;
  }
  nav a {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
  }
  nav a:hover {
    color: var(--accent);
  }
  nav a.cta {
    color: var(--accent);
    border: 1px solid color-mix(in oklab, var(--accent) 45%, var(--line));
    padding: 9px 16px;
    border-radius: 4px;
    transition:
      background 0.2s,
      color 0.2s;
  }
  nav a.cta:hover {
    background: var(--accent);
    color: var(--on-accent);
  }
  .wl-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 38px;
    height: 32px;
    padding: 0 8px;
    background: none;
    border: 1px solid var(--line);
    border-radius: 6px;
    cursor: pointer;
    flex: none;
  }
  .wl-toggle span {
    display: block;
    height: 1.5px;
    background: var(--text);
    border-radius: 2px;
    transition:
      transform 0.25s,
      opacity 0.2s;
  }
  .wl-toggle:hover {
    border-color: var(--accent);
  }
  .wl-head.nav-open .wl-toggle span:nth-child(1) {
    transform: translateY(6.5px) rotate(45deg);
  }
  .wl-head.nav-open .wl-toggle span:nth-child(2) {
    opacity: 0;
  }
  .wl-head.nav-open .wl-toggle span:nth-child(3) {
    transform: translateY(-6.5px) rotate(-45deg);
  }

  @media (max-width: 1080px) {
    .wl-head-in {
      padding: 22px 32px;
    }
    nav {
      gap: 22px;
    }
  }
  @media (max-width: 900px) {
    .wl-head-in {
      padding: 16px 20px;
    }
    .wl-mark {
      width: 34px;
    }
    .wl-logo span {
      font-size: 12px;
      letter-spacing: 0.16em;
    }
    .wl-toggle {
      display: flex;
    }
    nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      z-index: 60;
      flex-direction: column;
      gap: 0;
      background: var(--bg-deep);
      border-bottom: 1px solid var(--line);
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.32s cubic-bezier(0.2, 0.8, 0.3, 1);
    }
    .wl-head.nav-open nav {
      max-height: 340px;
    }
    nav a {
      color: var(--text);
      padding: 17px 20px;
      border-top: 1px solid var(--line);
      width: 100%;
    }
    nav a.cta {
      border: none;
      border-top: 1px solid var(--line);
      border-radius: 0;
      padding: 17px 20px;
    }
  }
</style>
