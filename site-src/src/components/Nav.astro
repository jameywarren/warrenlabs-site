---
// Warren Labs header for the migrated pages.
//
// The link list comes from src/data/nav.js, which is also what tools/sync-chrome.mjs renders
// into the hand-written pages. Change the nav there, not here.
//
// Deliberately NOT sharing /css/styles.css with the hand-written site: that sheet and this
// section's global.css both define .wrap, .btn, .mono, body and a, so linking both would collide.
// These styles are scoped by Astro and are a visual match for the site header.
import { NAV, MARK_PATH, nbsp } from '../data/nav.js';

interface Props {
  variant?: 'home' | 'attune';
}
const { variant = 'home' } = Astro.props;
---

<header class="wl-head" data-variant={variant}>
  <div class="wl-head-in">
    <a class="wl-logo" href="/" aria-label="Warren Labs">
      <svg class="wl-mark" viewBox="0 0 120 80" aria-hidden="true">
        <path
          d={MARK_PATH}
          fill="none"
          stroke="currentColor"
          stroke-width="6.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
      <span>WARREN&nbsp;LABS</span>
    </a>

    <nav id="wl-nav">
      {NAV.map((l) => <a href={l.href} class={l.cta ? 'cta' : undefined} set:html={nbsp(l.label)} />)}
    </nav>

    {/* Page-specific header actions, immediately before the theme toggle. Currently unused —
        /graphs briefly put its settings gear here, then moved it back beside its own controls,
        where a graph-specific setting belongs. Kept because the slot costs nothing and the next
        page that wants a header action shouldn't have to re-invent it. */}
    <slot name="actions" />

    <button class="wl-theme" id="wl-theme" aria-label="Switch between light and dark" title="Light / dark">◐</button>

    <button class="wl-toggle" aria-label="Menu" aria-expanded="false" aria-controls="wl-nav">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<script>
  const head = document.querySelector('.wl-head');
  const toggle = document.querySelector('.wl-toggle');
  if (head && toggle) {
    const set = (open) => {
      head.classList.toggle('nav-open', open);
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    };
    toggle.addEventListener('click', () => set(!head.classList.contains('nav-open')));
    head.querySelectorAll('nav a').forEach((a) => a.addEventListener('click', () => set(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') set(false);
    });
  }

  // Light/dark toggle. Layout.astro has already stamped any STORED choice before first paint; this
  // only handles clicks. First click resolves the current *computed* theme (which may have come from
  // the OS) and flips it, so the button always does the visible thing rather than jumping to a
  // default. Writing data-theme pins the choice in both directions — see wl-web/README.md.
  const themeBtn = document.getElementById('wl-theme');
  if (themeBtn) {
    const root = document.documentElement;
    // No data-theme means DARK — the site no longer reads prefers-color-scheme. Falling back to
    // matchMedia here would make the first click a no-op on a light-preferring machine: it would
    // compute "currently light" for a page that is actually dark, then "switch" to dark.
    const current = () => root.getAttribute('data-theme') || 'dark';
    themeBtn.addEventListener('click', () => {
      const next = current() === 'dark' ? 'light' : 'dark';
      root.setAttribute('data-theme', next);
      try {
        localStorage.setItem('wl-theme', next);
      } catch (e) {
        /* private mode — the choice just won't persist across navigations */
      }
      // Keep the mobile browser chrome in step with the page.
      const meta = document.querySelector('meta[name="theme-color"]');
      if (meta) meta.setAttribute('content', next === 'dark' ? '#0c0d0f' : '#f7f8f9');
      // Canvas plots don't reflow on a CSS variable change — they have to be told.
      window.dispatchEvent(new CustomEvent('wl-theme-change', { detail: { theme: next } }));
    });
  }
</script>

<style>
  .wl-head {
    /* border-box + a fixed height puts the 1px border INSIDE the token, so --wl-head-h is the
       header's true total height. Without this, calc(100vh - var(--wl-head-h)) on /graphs is off
       by exactly the border and the page scrolls 1px — which is how the original 68px drifted. */
    box-sizing: border-box;
    height: var(--wl-head-h);
    border-bottom: 1px solid var(--line);
    position: relative;
    background: var(--bg);
  }
  .wl-head-in {
    display: flex;
    justify-content: space-between;
    align-items: center;
    /* Fixed height from the token, not vertical padding: /graphs sizes itself against
       var(--wl-head-h), and a padding-derived height silently drifts out of step with it. */
    height: 100%;
    padding: 0 60px;
    max-width: 1320px;
    margin: 0 auto;
  }
  .wl-logo {
    display: flex;
    align-items: center;
    gap: 11px;
    color: var(--text);
    text-decoration: none;
  }
  /* The sine-W carries the accent; the WARREN LABS wordmark stays ink. This matches the plugins —
     wl-ui/WLBrand.h has drawWarrenLabsMarkAccent for exactly this, so the mark is amber on a
     faceplate and was the only place it wasn't on the web. Identity, not decoration, so it doesn't
     break the signal-state-only rule for the accent. */
  .wl-mark {
    color: var(--accent);
    width: 34px;
    height: auto;
    display: block;
    overflow: visible;
    flex: none;
  }
  .wl-logo span {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 15px;
    letter-spacing: 0.22em;
  }
  nav {
    display: flex;
    gap: 32px;
    align-items: center;
  }
  nav a {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
  }
  nav a:hover {
    color: var(--accent);
  }
  nav a.cta {
    color: var(--accent);
    border: 1px solid color-mix(in oklab, var(--accent) 45%, var(--line));
    padding: 9px 16px;
    border-radius: 4px;
    transition:
      background 0.2s,
      color 0.2s;
  }
  nav a.cta:hover {
    background: var(--accent);
    color: var(--on-accent);
  }
  /* Light/dark. Same ◐ glyph and same round-button treatment Attune uses in its header, so the two
     surfaces read as one product. Stays visible at mobile widths — it's one of the few controls
     worth keeping outside the hamburger, since it's how a light-mode user fixes a dark page. */
  .wl-theme {
    width: 32px;
    height: 32px;
    flex: none;
    display: grid;
    place-items: center;
    margin-left: 14px;
    background: none;
    border: 1px solid var(--line);
    border-radius: 50%;
    color: var(--muted);
    font-size: 14px;
    line-height: 1;
    cursor: pointer;
    transition:
      color 0.14s,
      border-color 0.14s;
  }
  .wl-theme:hover {
    color: var(--text);
    border-color: var(--muted-2);
  }
  .wl-theme:focus-visible {
    outline: none;
    border-color: var(--accent-line);
    box-shadow: 0 0 0 3px var(--accent-dim);
  }

  .wl-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 38px;
    height: 32px;
    padding: 0 8px;
    background: none;
    border: 1px solid var(--line);
    border-radius: 6px;
    cursor: pointer;
    flex: none;
  }
  .wl-toggle span {
    display: block;
    height: 1.5px;
    background: var(--text);
    border-radius: 2px;
    transition:
      transform 0.25s,
      opacity 0.2s;
  }
  .wl-toggle:hover {
    border-color: var(--accent);
  }
  .wl-head.nav-open .wl-toggle span:nth-child(1) {
    transform: translateY(6.5px) rotate(45deg);
  }
  .wl-head.nav-open .wl-toggle span:nth-child(2) {
    opacity: 0;
  }
  .wl-head.nav-open .wl-toggle span:nth-child(3) {
    transform: translateY(-6.5px) rotate(-45deg);
  }

  /* Header fit, measured 2026-09-01 rather than guessed. At full size the row needs about
     990px of content: logo 180 + nav 777 + theme button 32. The old first step down was at
     1080px, which left the wordmark and the first nav link touching with zero gap anywhere
     from roughly 900 to 1180. Two steps now, so the full nav survives every common laptop
     width (1024, 1152, 1280) and the drawer takes over before anything collides. */
  @media (max-width: 1260px) {
    .wl-head-in {
      padding: 0 32px;
    }
    nav {
      gap: 22px;
    }
  }
  /* Last stop before the drawer. Type comes down a step and the gaps tighten; together this
     buys back roughly 150px. It starts at 1120 rather than 1040 because the nav
     carries eight items: with seven there was room to wait, with eight there is a pinch at ~1100. */
  @media (max-width: 1120px) {
    .wl-head-in {
      padding: 0 24px;
    }
    nav {
      gap: 15px;
    }
    nav a {
      font-size: 11.5px;
      letter-spacing: 0.09em;
    }
    nav a.cta {
      padding: 9px 14px;
    }
    .wl-mark {
      width: 30px;
    }
    .wl-logo {
      gap: 9px;
    }
    .wl-logo span {
      font-size: 13px;
      letter-spacing: 0.14em;
    }
  }
  @media (max-width: 940px) {
    .wl-head-in {
      padding: 0 20px;
    }
    .wl-mark {
      width: 30px;
    }
    .wl-logo span {
      font-size: 12px;
      letter-spacing: 0.16em;
    }
    .wl-toggle {
      display: flex;
    }
    nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      z-index: 60;
      flex-direction: column;
      gap: 0;
      background: var(--bg-deep);
      border-bottom: 1px solid var(--line);
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.32s cubic-bezier(0.2, 0.8, 0.3, 1);
    }
    .wl-head.nav-open nav {
      max-height: 340px;
    }
    nav a {
      color: var(--text);
      padding: 17px 20px;
      border-top: 1px solid var(--line);
      width: 100%;
      /* Undo the 1040px squeeze: in the drawer each link is a full-width row with room to
         spare, so the tightened tracking would read as a mistake rather than as economy. */
      font-size: 12px;
      letter-spacing: 0.14em;
    }
    nav a.cta {
      border: none;
      border-top: 1px solid var(--line);
      border-radius: 0;
      padding: 17px 20px;
    }
  }
</style>
