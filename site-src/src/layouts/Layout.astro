---
import '../styles/tokens.css';
import '../styles/global.css';
import Signup from '../components/Signup.astro';
import { FORMSPREE } from '../data/config.js';
import { ANALYTICS } from '../data/nav.js';

interface Props {
  title: string;
  description?: string;
  image?: string;
  ogType?: 'website' | 'article';
  signup?: 'sonicTemple' | 'attune';
  jsonLd?: object | object[];
  /** Load Instrument Serif. Only /attune needs it, for the product wordmark. */
  wordmark?: boolean;
  /**
   * Which mark owns the browser tab. 'wl' (the sine-W) everywhere Warren Labs is the speaker,
   * which is everywhere but one page. 'attune' only on /attune, where Attune speaks and the
   * Attune mark leads. See the note on the lock-up in attune.astro.
   */
  favicon?: 'wl' | 'attune';
  /**
   * Keep the page out of search. For handout targets (a QR code on printed paper) that are public
   * URLs but are not pages we want indexed. Emits robots noindex AND drops the canonical link —
   * a canonical on a noindexed page is a mixed signal. Pair it with the sitemap filter in
   * astro.config.mjs, or the page is excluded and advertised at the same time.
   */
  noindex?: boolean;
}

const {
  title,
  description = 'Headphone measurement, level-matched comparison, and Attune, a Mac app that tunes any headphone to your taste. From Jamey Warren at Warren Labs.',
  image,
  ogType = 'website',
  signup = 'sonicTemple',
  jsonLd,
  wordmark = false,
  favicon = 'wl',
  noindex = false,
} = Astro.props;

// Migrated from sonictemple.io 2026-07-30. Canonical is warrenlabs.com now; the old domain gets
// no redirects (it never had traffic and nothing linked to it), so these are the only URLs.
const SITE = 'https://warrenlabs.com';
const canonical = new URL(Astro.url.pathname, SITE).href;
// The per-page /og/<slug>.png cards were generated against the Sonic Temple lockup and did not
// come across. Everything falls back to the Warren Labs card until they are regenerated.
const ogImage = new URL(image ?? '/assets/brand/og-card.png', SITE).href;
const endpoint = FORMSPREE[signup] ?? '';

const organization = {
  '@type': 'Organization',
  '@id': `${SITE}/#organization`,
  name: 'Warren Labs',
  url: SITE,
  logo: `${SITE}/assets/brand/png/wl-mark_amber_512.png`,
  description:
    'Audio product work by Jamey Warren: headphones, amps, DACs, DSP, and the software around them.',
  founder: { '@type': 'Person', name: 'Jamey Warren' },
};

const website = {
  '@type': 'WebSite',
  '@id': `${SITE}/#website`,
  url: SITE,
  name: 'Warren Labs',
  inLanguage: 'en',
  publisher: { '@id': `${SITE}/#organization` },
};

const extra = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];
const ld = { '@context': 'https://schema.org', '@graph': [organization, website, ...extra] };
---

<!doctype html>
<html lang="en" data-palette="graphite" data-type="barlow">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {
      /* Theme, resolved BEFORE first paint. This has to be inline and first in <head>: if the
         stored choice were applied after stylesheets load, a light-mode visitor would get a
         full-frame flash of the dark palette on every navigation. Only an explicit toggle is
         stored — with nothing stored we leave data-theme unset so wl-tokens' prefers-color-scheme
         block follows the OS, which is the behaviour Attune already has. */
    }
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('wl-theme');
          if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
        } catch (e) {
          /* Safari private mode throws on localStorage. Fall through to the OS preference. */
        }
      })();
    </script>
    {/* /favicon.ico stays the W on every page: it is the last-resort guess for a browser too old
        to read the SVG, and falling back to the lab's mark is the right failure. */}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    {
      favicon === 'attune' ? (
        <Fragment>
          {/* One file for both browser themes — the ground is graphite, the same reasoning that
              made the app icon dark-ground. No prefers-color-scheme pair needed. */}
          <link rel="icon" type="image/svg+xml" href="/assets/attune/attune-favicon.svg" />
          <link rel="apple-touch-icon" href="/assets/attune/attune-appicon-180.png" />
        </Fragment>
      ) : (
        <Fragment>
          <link rel="icon" type="image/svg+xml" href="/assets/brand/svg/wl-favicon_black_32.svg" />
          <link
            rel="icon"
            type="image/svg+xml"
            href="/assets/brand/svg/wl-favicon_white_32.svg"
            media="(prefers-color-scheme: dark)"
          />
          <link rel="apple-touch-icon" href="/assets/brand/png/wl-appicon_amber-graphite_180.png" />
        </Fragment>
      )
    }
    <link rel="manifest" href="/site.webmanifest" />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#16181B" />
    {/* Plausible. Cookieless, so it needs no consent banner and sets nothing; see /privacy.
        Config is nav.json so this page, the hand-written pages (tools/sync-chrome.mjs) and the
        /plugins pages (gen_site.py) cannot drift apart. `defer` keeps it off the critical path. */}
    {ANALYTICS.enabled && (
      <script defer data-domain={ANALYTICS.domain} src={ANALYTICS.src}></script>
    )}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow:wght@500;600;700&family=JetBrains+Mono:wght@400;500&family=Archivo:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    {
      /* Instrument Serif is NOT part of the Warren Labs type system. It is loaded only on pages
         that render the Attune wordmark, which keeps its own signature the way the app does.
         SELF-HOSTED, and specifically the same web/fonts/InstrumentSerif-Regular.woff2 the app
         bundles and that tools/make_lockup.py cuts the outlined lock-ups from — so the wordmark
         here and the wordmark in the running app are one typeface by construction, not by
         trusting two CDNs to agree.

         font-display is BLOCK, not swap. Instrument Serif is not a system font, so a swap would
         paint the hero wordmark in Georgia first and then reflow it — wider and heavier, which is
         the exact defect that shipped once already. A same-origin 25 KB preload makes the block
         period imperceptible; a flash of the wrong face would not be. */
      wordmark && (
        <Fragment>
          <link
            rel="preload"
            href="/assets/attune/InstrumentSerif-Regular.woff2"
            as="font"
            type="font/woff2"
            crossorigin
          />
          <style
            is:inline
            set:html={`@font-face{font-family:'Instrument Serif';font-style:normal;font-weight:400;font-display:block;src:url('/assets/attune/InstrumentSerif-Regular.woff2') format('woff2');}`}
          />
        </Fragment>
      )
    }
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Warren Labs" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <body>
    <slot />
    <Signup endpoint={endpoint} />
  </body>
</html>
